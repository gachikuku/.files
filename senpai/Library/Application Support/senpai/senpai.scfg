address "chitchat.kamil.gr:6697"
nickname "gachikuku"
password-cmd gopass --password soju
colors {
	nicks fixed grey green
}
pane-widths {
	members 0
	channels 0
}
typings false

# The one-line scroll actions are supplied by the Nix senpai package override.
shortcuts {
	Control+k scroll-up-line
	Control+j scroll-down-line
	Control+g set-editor "/buffer "
	Control+b cursor-left
	Control+f cursor-right
}
