  "colors": {
    "screen_background": "paper",
    "screen_text": "black",
    "chrome_background": "statusBg",
    "chrome_text": "black",
    "muted_text": "base600",
    "sidebar_background": "statusBg",
    "border": "base500",
    "transcript_background": "paper",
    "prompt_background": "statusBg",
    "prompt_text": "black",
    "prompt_border": "base600",
    "autocomplete_background": "paper",
    "accent": "base600",
    "success": "green",
    "error": "red",
    "tool_success_text": "green",
    "tool_error_text": "red",
    "highlight_background": "ui1",
    "highlight_text": "black",
    "markdown_heading": "black",
    "markdown_table_header": "base600",
    "markdown_table_border": "base300",
    "markdown_inline_code": "inlineCode",
    "markdown_code_block_background": "paper",
    "markdown_link": "blue",
    "markdown_bullet": "base600",
    "completion_selected": "bold black on ui1",
