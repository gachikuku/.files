{
  "name": "flexoki-light",
  "dark": false,
  "syntax_theme": "solarized-light",
  "vars": {
    "paper": "#fffcf0",
    "base300": "#b7b5ac",
    "base500": "#878580",
    "base600": "#6f6e69",
    "base700": "#575653",
    "base800": "#403e3c",
    "base900": "#282726",
    "black": "#100f0f",
    "ui1": "#e6e4d9",
    "statusBg": "#f2f0e5",
    "red": "#af3029",
    "orange": "#bc5215",
    "yellow": "#ad8301",
    "green": "#66800b",
    "cyan": "#24837b",
    "blue": "#205ea6",
    "purple": "#5e409d",
    "magenta": "#a02f6f",
    "inlineCode": "#547565"
  },
  "syntax": {
    "comment": "base500",
    "keyword": "magenta",
    "function": "purple",
    "variable": "cyan",
    "string": "green",
