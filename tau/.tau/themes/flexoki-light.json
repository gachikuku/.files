    "status": { "border": "base500", "body": "base600 on statusBg" },
    "thinking": { "border": "base500", "body": "base600 on paper" },
    "skill": { "border": "purple", "body": "purple on paper" },
    "custom": { "border": "base700", "body": "black on statusBg" },
    "branch_summary": { "border": "purple", "body": "purple on paper" },
    "compaction_summary": { "border": "purple", "body": "purple on paper" }
