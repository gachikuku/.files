{
  "description": "Keep macOS awake during main turns and send sparse Pushover alerts.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/python3 ~/.codex/hooks/caffeinate_control.py",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/python3 ~/.codex/hooks/caffeinate_control.py",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/python3 ~/.codex/hooks/pushover_notify.py",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/python3 ~/.codex/hooks/pushover_notify.py",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/python3 ~/.codex/hooks/pushover_notify.py",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^update_goal$",
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/python3 ~/.codex/hooks/pushover_notify.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/python3 ~/.codex/hooks/caffeinate_control.py",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/python3 ~/.codex/hooks/caffeinate_control.py",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
