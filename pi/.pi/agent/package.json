{
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@effect/platform-node": "^4.0.0-beta.99",
    "acorn": "^8.17.0",
    "effect": "^4.0.0-beta.99",
    "firecrawl": "^4.30.1",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.24.2",
    "@effect/vitest": "^4.0.0-beta.99",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "undici": "8.9.0"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/{appearance,ask-user,background-terminals,copy-all,file-search,firecrawl-search,git-info,shared,spark-strict-tools,subagents,summaries,workflows}/**/*.{ts,cjs}\" \"package*.json\" \"tsconfig.json\"",
    "format:check": "prettier --check \"extensions/{appearance,ask-user,background-terminals,copy-all,file-search,firecrawl-search,git-info,shared,spark-strict-tools,subagents,summaries,workflows}/**/*.{ts,cjs}\" \"package*.json\" \"tsconfig.json\"",
    "test": "node --test --experimental-strip-types extensions/appearance/*.test.ts extensions/background-terminals/*.test.ts extensions/firecrawl-search/*.test.ts extensions/git-info/*.test.ts extensions/shared/*.test.ts extensions/subagents/by-the-way.test.ts extensions/subagents/context-usage.test.ts extensions/subagents/manager.test.ts extensions/subagents/result-delivery.test.ts extensions/subagents/takeover.test.ts extensions/summaries/*.test.ts extensions/workflows/*.test.ts && npm --prefix extensions/file-search test",
    "test:live": "npm --prefix extensions/subagents run test:live"
  }
}
