#!/bin/sh

pidfile="${XDG_RUNTIME_DIR:-/tmp}/sacc-mpv.pid"

cleanup() {
    if [ -f "$pidfile" ]; then
        pid=$(cat "$pidfile" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null
        fi
        rm -f "$pidfile"
    fi
}

trap cleanup EXIT INT TERM HUP
sacc "gopher://127.0.0.1:7070/1/radio/lawn"
cleanup
