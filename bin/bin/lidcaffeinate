#!/bin/sh

# Keep the Mac awake with its lid closed for the lifetime of a command.

usage() {
  cat <<'EOF'
Usage: lidcaffeinate [command [argument ...]]

Prevent idle and lid-close sleep until the command exits. With no command,
stay awake until interrupted. Run this program as your normal user; it uses
sudo only for the pmset changes.
EOF
}

case "${1-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

if [ "$(/usr/bin/id -u)" -eq 0 ]; then
  echo 'lidcaffeinate: run without sudo; pmset is elevated internally' >&2
  exit 2
fi

restore_sleep=1
# Codex owns a temporary, shared controller and must restore sleep after its
# last turn, even if a previous controller left the global setting enabled.
# Standalone callers continue to preserve an already-disabled sleep setting.
if [ "${LIDCAFFEINATE_RESTORE_SLEEP:-0}" != 1 ] &&
  /usr/bin/pmset -g | /usr/bin/grep -q 'SleepDisabled[[:space:]]*1'; then
  restore_sleep=0
fi

runtime_dir=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/lidcaffeinate.XXXXXX")
/bin/chmod 700 "$runtime_dir"
restore_marker="$runtime_dir/restore-sleep"
controller_pid=$$
controller_state_file=${LIDCAFFEINATE_STATE_FILE-}

tracked_controller_pid() {
  # Python writes this small record atomically. Only its numeric pid matters.
  [ -n "$controller_state_file" ] || return 0
  /usr/bin/sed -nE 's/.*"pid":[[:space:]]*([0-9]+).*/\1/p' "$controller_state_file" 2>/dev/null || true
}

has_lid_session() {
  for session_state in "${controller_state_file%/*}"/session-*.json; do
    [ -f "$session_state" ] || continue
    if /usr/bin/grep -Eq '"mode":[[:space:]]*"lid"' "$session_state"; then
      return 0
    fi
  done
  return 1
}

replacement_controller_running() {
  replacement_pid=$(tracked_controller_pid)
  case "$replacement_pid" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$replacement_pid" != "$controller_pid" ] || return 1
  replacement_command=$(/bin/ps -p "$replacement_pid" -o command= 2>/dev/null) || return 1
  [ "$replacement_command" = "/bin/sh $0" ]
}

restore_sleep_setting() {
  # A surviving controller may have recovered the flag after another one
  # stopped. It then owns restoring normal sleep as well.
  if [ "$restore_sleep" -eq 1 ] || [ -e "$restore_marker" ]; then
    # An obsolete helper must not clear a replacement helper's protection.
    if ! replacement_controller_running; then
      /usr/bin/sudo -n -- /usr/bin/pmset -a disablesleep 0 ||
        echo 'lidcaffeinate: could not restore normal sleep' >&2
    fi
  fi

  /bin/rm -f -- "$restore_marker"
  /bin/rmdir "$runtime_dir" 2>/dev/null || true
}

cleanup() {
  exit_code=$?
  trap - 0 1 2 15

  if [ -n "${watchdog_pid-}" ]; then
    /bin/kill -TERM "$watchdog_pid" 2>/dev/null || true
    wait "$watchdog_pid" 2>/dev/null || true
    watchdog_pid=
  fi

  if [ -n "${caffeinate_pid-}" ]; then
    /bin/kill -TERM "$caffeinate_pid" 2>/dev/null || true
    wait "$caffeinate_pid" 2>/dev/null || true
    caffeinate_pid=
  fi

  restore_sleep_setting

  /usr/bin/pmset -g | /usr/bin/grep SleepDisabled ||
    echo 'SleepDisabled: 0 (normal lid sleep restored)'

  exit "$exit_code"
}

trap cleanup 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15

if ! /usr/bin/sudo -n -- /usr/bin/pmset -a disablesleep 1; then
  echo 'lidcaffeinate: passwordless sudo permission for pmset is required' >&2
  exit 1
fi

/usr/bin/caffeinate -i "$@" &
caffeinate_pid=$!

# `pmset disablesleep` is global and can be reset by another lidcaffeinate
# cleanup or by a later power-configuration update. Keep the assertion healthy
# for this controller's entire lifetime. If we have to recover it, remember to
# restore normal lid sleep when the final controller exits.
(
  ownership_grace=1
  while :; do
    # SIGKILL bypasses the controller's traps. Do not leave its detached
    # caffeinate process and global sleep setting alive after the owner dies.
    if ! /bin/kill -0 "$controller_pid" 2>/dev/null; then
      /bin/kill -TERM "$caffeinate_pid" 2>/dev/null || true
      restore_sleep_setting
      exit 0
    fi
    /bin/kill -0 "$caffeinate_pid" 2>/dev/null || exit 0
    # A killed/timed-out hook can leave its detached helper alive without a
    # tracking record. Allow one startup tick for publication, then retire it
    # as soon as it is no longer the recorded Codex controller.
    if [ -n "$controller_state_file" ] && [ "$ownership_grace" -eq 0 ]; then
      if [ "$(tracked_controller_pid)" != "$controller_pid" ] || ! has_lid_session; then
        /bin/kill -TERM "$controller_pid" 2>/dev/null || true
        exit 0
      fi
    fi
    ownership_grace=0
    current=$(/usr/bin/pmset -g | /usr/bin/awk '/SleepDisabled/{print $2; exit}')
    if [ "${current:-0}" != 1 ]; then
      : > "$restore_marker"
      if ! /usr/bin/sudo -n -- /usr/bin/pmset -a disablesleep 1; then
        echo 'lidcaffeinate: could not restore lid-sleep protection' >&2
        /bin/kill -TERM "$controller_pid" 2>/dev/null || true
        exit 1
      fi
    fi
    /bin/sleep 1
  done
) &
watchdog_pid=$!

wait "$caffeinate_pid"
exit_code=$?
caffeinate_pid=
exit "$exit_code"
