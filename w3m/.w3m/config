# w3m config overrides (stowed from ~/.files/w3m/.w3m/config)

# External editor for C-o (edit input line), E (edit source), ESC-e, etc.
# The compiled-in default on this build is a dead /no-such-path/bin/vi,
# so it must be set explicitly. Bare "nvim" resolves via PATH (portable
# across NixOS and macOS, where the store path differs).
editor	nvim

# Use our portable launcher: it honors $BROWSER, then falls back to the
# platform opener. The trailing ampersand prevents w3m from waiting for a GUI.
extbrowser	$HOME/.w3m/open-url %s &

# Keep pages text-only, with clickable placeholders for images that have no
# useful ALT text. Capital I sends only the selected image to Plan 9 page(1);
# images are never rendered automatically in the w3m pane.
pseudo_inlines	true
ignore_null_img_alt	true
display_link	true
display_image	false
ext_image_viewer	true

# Smooth mouse-wheel reading: move exactly one line per wheel tick instead of
# w3m's default fixed jump of five lines.
relative_wheel_scroll	false
fixed_wheel_scroll_count	1

# Accept self-signed/untrusted certificates without prompting. This disables
# certificate-chain verification globally; HTTPS traffic can be intercepted.
ssl_verify_server	false

# GitHub currently sends chunked HTTP/1.1 responses even though w3m requests
# HTTP/1.0. w3m does not remove that chunk framing before invoking gunzip,
# which causes "gunzip: unknown compression format". Requesting an
# uncompressed response avoids the broken gunzip path.
accept_encoding	identity
