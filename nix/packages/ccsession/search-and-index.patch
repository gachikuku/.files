+package codex
+
+import (
+	"errors"
+	"path/filepath"
+	"testing"
+
+	"github.com/sorafujitani/ccsession/internal/session"
+)
+
+func TestJSONLFallbackExcludesSubagents(t *testing.T) {
+	for _, tc := range []struct {
+		name, fields string
+		child        bool
+	}{
+		{"subagent source", `"source":{"subagent":{"thread_spawn":{"parent_thread_id":"parent"}}}`, true},
+		{"agent path", `"agent_path":"root/worker"`, true},
+		{"parent thread", `"parent_thread_id":"parent"`, true},
+		{"main CLI", `"source":"cli"`, false},
+		{"main null fields", `"source":null,"agent_path":null,"parent_thread_id":null`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			home := t.TempDir()
+			const id = "019a1b2c-3d4e-75f6-8890-abcde1234567"
+			body := `{"type":"session_meta","payload":{"id":"` + id + `","cwd":"` + home + `",` + tc.fields + `}}` + "\n" +
+				`{"type":"response_item","payload":{"type":"message","role":"user","content":[{"type":"input_text","text":"Synthetic request"}]}}` + "\n"
+			writeSession(t, home, id, body)
+			path := filepath.Join(home, "sessions/2026/06/14/rollout-2026-06-14T00-00-00-"+id+".jsonl")
+			store := OpenAt(home)
+			ss, err := store.Scan()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if tc.child {
+				if len(ss) != 0 {
+					t.Errorf("fallback listed child session: %+v", ss)
+				}
+				if _, err := store.FindByID(id); !errors.Is(err, session.ErrSessionFileMissing) {
+					t.Errorf("FindByID child: got %v, want missing", err)
+				}
+				if _, err := store.FindByLocator(id, path); !errors.Is(err, session.ErrSessionFileMissing) {
+					t.Errorf("FindByLocator child: got %v, want missing", err)
+				}
+			} else {
+				if len(ss) != 1 || ss[0].ID != id {
+					t.Fatalf("fallback lost main session: %+v", ss)
+				}
+				if _, err := store.FindByLocator(id, path); err != nil {
+					t.Errorf("FindByLocator main session: %v", err)
+				}
+			}
+		})
+	}
+}
+
+func TestIndexedLocatorDoesNotBypassSubagentFilter(t *testing.T) {
+	// Older JSONL metadata may omit child markers while the live SQLite
+	// projection knows the session is a child. A locator must not bypass it.
+	home, cwd, id := fixture(t)
+	store := OpenAt(home)
+	before, err := store.FindByID(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	db := testIndexDB(t, home, "state_5.sqlite", testStateSchema)
+	if _, err := db.Exec(`INSERT INTO threads (id, rollout_path, cwd, title, agent_path)
+ VALUES (?, ?, ?, 'synthetic child', 'root/worker')`, id, before.JSONLPath, cwd); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.FindByLocator(id, before.JSONLPath); !errors.Is(err, session.ErrSessionFileMissing) {
+		t.Fatalf("FindByLocator bypassed the indexed child filter: %v", err)
+	}
+}
