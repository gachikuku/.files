new file mode 100644
index 0000000..d6e1f80
--- /dev/null
+++ b/internal/codex/index.go
@@ -0,0 +1,334 @@
+package codex
+
+// Codex's SQLite projections contain the same metadata and visible messages as
+// the rollout files, without requiring a scan of potentially enormous JSONL
+// logs. Older installations and unsupported schemas retain the JSONL reader.
+import (
+	"database/sql"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	_ "github.com/ncruces/go-sqlite3/driver"
+	"github.com/sorafujitani/ccsession/internal/filescan"
+	"github.com/sorafujitani/ccsession/internal/session"
+)
+
+func openIndex(home, prefix string) (*sql.DB, error) {
+	paths, err := filepath.Glob(filepath.Join(home, prefix+"_*.sqlite"))
+	if err != nil {
+		return nil, err
+	}
+	version := func(path string) int {
+		n, _ := strconv.Atoi(strings.TrimSuffix(strings.TrimPrefix(filepath.Base(path), prefix+"_"), ".sqlite"))
+		return n
+	}
+	slices.SortFunc(paths, func(a, b string) int { return version(b) - version(a) })
+	for _, path := range paths {
+		if fi, err := os.Stat(path); err != nil || fi.IsDir() || version(path) == 0 {
+			continue
+		}
+		path, err = filepath.Abs(path)
+		if err != nil {
+			return nil, err
+		}
+		u := url.URL{Scheme: "file", Path: path}
+		// Do not use immutable=1: live Codex sessions are commonly in the WAL.
+		u.RawQuery = "mode=ro&_pragma=busy_timeout(1000)&_pragma=query_only(1)"
+		db, err := sql.Open("sqlite3", u.String())
+		if err == nil {
+			db.SetMaxOpenConns(1)
+		}
+		return db, err
+	}
+	return nil, os.ErrNotExist
+}
+
+func indexColumns(db *sql.DB, table string) (map[string]bool, error) {
+	// Table names are internal constants, never caller input.
+	rows, err := db.Query("PRAGMA table_info(" + table + ")")
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	columns := make(map[string]bool)
+	for rows.Next() {
+		var cid, notNull, pk int
+		var name, typ string
+		var defaultValue any
+		if err := rows.Scan(&cid, &name, &typ, &notNull, &defaultValue, &pk); err != nil {
+			return nil, err
+		}
+		columns[name] = true
+	}
+	return columns, rows.Err()
+}
+
+func indexCoalesce(columns map[string]bool, fallback string, names ...string) string {
+	parts := make([]string, 0, len(names)+1)
+	for _, name := range names {
+		if columns[name] {
+			parts = append(parts, "NULLIF("+name+", '')")
+		}
+	}
+	if len(parts) == 0 {
+		return fallback
+	}
+	return "COALESCE(" + strings.Join(append(parts, fallback), ", ") + ")"
+}
+
+func indexMillis(columns map[string]bool, names ...string) string {
+	var parts []string
+	for _, name := range names {
+		if columns[name] {
+			part := "NULLIF(" + name + ", 0)"
+			if !strings.HasSuffix(name, "_ms") {
+				part += " * 1000"
+			}
+			parts = append(parts, part)
+		}
+	}
+	if len(parts) == 0 {
+		return "0"
+	}
+	return "COALESCE(" + strings.Join(append(parts, "0"), ", ") + ")"
+}
+
+func (s *Store) indexedSessions(id string) ([]*session.Session, bool) {
+	db, err := openIndex(s.home, "state")
+	if err != nil {
+		return nil, false
+	}
+	defer db.Close()
+	columns, err := indexColumns(db, "threads")
+	if err != nil || !columns["id"] || !columns["rollout_path"] || !columns["cwd"] ||
+		(!columns["name"] && !columns["title"] && !columns["first_user_message"]) {
+		return nil, false
+	}
+	label := indexCoalesce(columns, "'(no user message)'", "name", "title", "first_user_message")
+	recent := indexMillis(columns, "recency_at_ms", "updated_at_ms", "recency_at", "updated_at")
+	where := []string{"1=1"}
+	for _, filter := range []struct{ column, condition string }{
+		{"archived", "COALESCE(archived, 0) = 0"},
+		{"agent_path", "(agent_path IS NULL OR agent_path IN ('', '/root'))"},
+		{"source", "COALESCE(source, '') NOT IN ('exec', 'subagent') AND CASE WHEN json_valid(source) THEN json_type(source, '$.subagent') IS NULL ELSE 1 END"},
+		{"originator", "COALESCE(originator, '') != 'codex_exec'"},
+	} {
+		if columns[filter.column] {
+			where = append(where, filter.condition)
+		}
+	}
+	var args []any
+	if id != "" {
+		where = append(where, "id = ?")
+		args = append(args, id)
+	}
+	rows, err := db.Query("SELECT id, COALESCE(cwd, ''), rollout_path, "+label+", "+recent+
+		" FROM threads WHERE "+strings.Join(where, " AND "), args...)
+	if err != nil {
+		return nil, false
+	}
+	defer rows.Close()
+	var ids []string
+	byID := make(map[string]*session.Session)
+	for rows.Next() {
+		var sess session.Session
+		var recentMS int64
+		if err := rows.Scan(&sess.ID, &sess.CWD, &sess.JSONLPath, &sess.Label, &recentMS); err != nil {
+			return nil, false
+		}
+		if sess.ID == "" || idCorruptsRow(sess.ID) || sess.JSONLPath == "" {
+			continue
+		}
+		sess.Label = session.SanitizeLabel(sess.Label)
+		sess.ProjectDir = filepath.Dir(sess.JSONLPath)
+		sess.LastTime = time.UnixMilli(recentMS)
+		sess.LastEpoch = sess.LastTime.Unix()
+		sess.CWDUnknown = sess.CWD == ""
+		if !sess.CWDUnknown {
+			sess.CWDBasename = filepath.Base(sess.CWD)
+			sess.CWDExists = pathIsDir(sess.CWD)
+		}
+		ids = append(ids, sess.ID)
+		byID[sess.ID] = &sess
+	}
+	if rows.Err() != nil {
+		return nil, false
+	}
+	// Bound each header read and overlap independent file opens. Parallel
+	// preserves row order; each callback owns a distinct session pointer.
+	out := filescan.Parallel(ids, func(id string) (*session.Session, bool) {
+		sess := byID[id]
+		meta, known := readSessionMetadata(sess.JSONLPath)
+		known = known && meta.ID == sess.ID
+		if known && meta.isSubagent() {
+			return nil, false
+		}
+		sess.ForkMetadataKnown = known
+		if known {
+			sess.ForkedFromID = cleanForkID(meta.ForkedFromID)
+		}
+		return sess, true
+	})
+	return out, true
+}
+
+func (s *Store) indexedMessages(sess *session.Session, limit int) ([]session.Message, time.Time, int, bool) {
+	db, err := openIndex(s.home, "state")
+	if err != nil {
+		return nil, time.Time{}, 0, false
+	}
+	columns, err := indexColumns(db, "threads")
+	if err != nil || !columns["id"] || !columns["rollout_path"] {
+		db.Close()
+		return nil, time.Time{}, 0, false
+	}
+	var path, preview string
+	var createdMS int64
+	err = db.QueryRow("SELECT rollout_path, "+indexCoalesce(columns, "''", "preview")+", "+
+		indexMillis(columns, "created_at_ms", "created_at")+" FROM threads WHERE id = ?", sess.ID).
+		Scan(&path, &preview, &createdMS)
+	db.Close()
+	if err != nil || filepath.Clean(path) != filepath.Clean(sess.JSONLPath) {
+		return nil, time.Time{}, 0, false
+	}
+	var startedAt time.Time
+	if createdMS != 0 {
+		startedAt = time.UnixMilli(createdMS)
+	}
+	if msgs, total, err := s.indexedHistory(sess.ID, limit); err == nil && total > 0 {
+		if startedAt.IsZero() && len(msgs) > 0 {
+			startedAt = msgs[0].Timestamp
+		}
+		return msgs, startedAt, total, true
+	}
+	// Even installations without a history projection often have a useful
+	// state preview. Prefer that to opening a multi-gigabyte rollout file.
+	if strings.TrimSpace(preview) != "" {
+		return []session.Message{{Role: "assistant", Timestamp: sess.LastTime, Body: preview}}, startedAt, 1, true
+	}
+	return nil, time.Time{}, 0, false
+}
+
+// Use one read-only connection for the entire search. Coverage is independent
+// of matches: a miss in a projected thread must not rescan its huge rollout.
+func (s *Store) indexedGrep(sessions []*session.Session, matchers map[string]func(string) bool) (map[string]struct{}, map[string]struct{}, error) {
+	matched, covered := make(map[string]struct{}), make(map[string]struct{})
+	if len(sessions) == 0 {
+		return matched, covered, nil
+	}
+	db, err := openIndex(s.home, "thread_history")
+	if err != nil {
+		return matched, covered, nil
+	}
+	defer db.Close()
+	columns, err := indexColumns(db, "thread_items")
+	if err != nil || !columns["thread_id"] || !columns["item_type"] || !columns["item_json"] {
+		return matched, covered, nil
+	}
+	args := make([]any, len(sessions))
+	for i, sess := range sessions {
+		args[i] = sess.ID
+	}
+	where := "thread_id IN (" + strings.TrimSuffix(strings.Repeat("?,", len(args)), ",") + ")"
+	rows, err := db.Query("SELECT DISTINCT thread_id FROM thread_items WHERE "+where, args...)
+	if err != nil {
+		return nil, nil, err
+	}
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			rows.Close()
+			return nil, nil, err
+		}
+		covered[id] = struct{}{}
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return nil, nil, err
+	}
+	rows, err = db.Query("SELECT thread_id, item_type, item_json FROM thread_items WHERE "+where+
+		" AND item_type IN ('userMessage', 'agentMessage')", args...)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var id, typ string
+		var raw []byte
+		if err := rows.Scan(&id, &typ, &raw); err != nil {
+			return nil, nil, err
+		}
+		if _, ok := matched[id]; ok {
+			continue
+		}
+		msg, supported := parseChatPayload(raw, typ, time.Time{})
+		if !supported {
+			delete(covered, id)
+			continue
+		}
+		if msg.Body != "" && matchers[id](msg.Body) {
+			matched[id] = struct{}{}
+		}
+	}
+	return matched, covered, rows.Err()
+}
+
+func (s *Store) indexedHistory(id string, limit int) ([]session.Message, int, error) {
+	db, err := openIndex(s.home, "thread_history")
+	if err != nil {
+		return nil, 0, err
+	}
+	defer db.Close()
+	columns, err := indexColumns(db, "thread_items")
+	if err != nil {
+		return nil, 0, err
+	}
+	for _, name := range []string{"thread_id", "item_type", "item_json", "rollout_ordinal"} {
+		if !columns[name] {
+			return nil, 0, fmt.Errorf("unsupported Codex history schema: missing %s", name)
+		}
+	}
+	// Count projected message items without decoding their JSON. Only the
+	// bounded preview query below extracts text; tool events are not messages.
+	var total int
+	if err := db.QueryRow("SELECT count(*) FROM thread_items WHERE thread_id = ? AND item_type IN ('userMessage', 'agentMessage')", id).Scan(&total); err != nil {
+		return nil, 0, err
+	}
+	// Decode exactly the same visible-chat shapes as grep. Streaming newest
+	// first allows a bounded preview to stop after enough visible messages.
+	rows, err := db.Query("SELECT item_type, item_json, "+indexMillis(columns, "started_at_ms", "created_at_ms")+
+		" FROM thread_items WHERE thread_id = ? AND item_type IN ('userMessage', 'agentMessage') ORDER BY rollout_ordinal DESC", id)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+	var msgs []session.Message
+	for rows.Next() {
+		var typ string
+		var raw []byte
+		var ms int64
+		if err := rows.Scan(&typ, &raw, &ms); err != nil {
+			return nil, 0, err
+		}
+		msg, supported := parseChatPayload(raw, typ, time.Time{})
+		if !supported || msg.Body == "" {
+			continue
+		}
+		if ms != 0 {
+			msg.Timestamp = time.UnixMilli(ms)
+		}
+		msgs = append(msgs, msg)
+		if limit > 0 && len(msgs) >= limit {
+			break
+		}
+	}
+	slices.Reverse(msgs)
+	return msgs, total, rows.Err()
+}
