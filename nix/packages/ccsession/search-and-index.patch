diff --git a/internal/grep/query.go b/internal/grep/query.go
new file mode 100644
index 0000000..fd74a83
--- /dev/null
+++ b/internal/grep/query.go
@@ -0,0 +1,154 @@
+package grep
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+	"unicode"
+)
+
+// QueryPlan ANDs chat-only regular expressions with fuzzy terms. Fuzzy terms
+// match an ID/title subsequence or a subsequence inside one visible chat word.
+type QueryPlan struct {
+	Patterns []string
+	Fuzzy    []string
+}
+type MatcherFactory func(id, label string) func(body string) bool
+
+// ParseQuery returns nil when there are no quotes, retaining native fzf or
+// literal grep semantics. Quoted regex preserves backslashes; bare terms are
+// fuzzy in normal mode and literal in grep mode.
+func ParseQuery(raw string, fuzzyBare bool) (*QueryPlan, error) {
+	if !strings.Contains(raw, `"`) {
+		return nil, nil
+	}
+	chars := []rune(raw)
+	plan := &QueryPlan{}
+	for i := 0; i < len(chars); {
+		if unicode.IsSpace(chars[i]) {
+			i++
+			continue
+		}
+		start := i
+		if chars[i] == '"' {
+			i++
+			start = i
+			escaped := false
+			for i < len(chars) {
+				if chars[i] == '"' && !escaped {
+					break
+				}
+				if chars[i] == '\\' {
+					escaped = !escaped
+				} else {
+					escaped = false
+				}
+				i++
+			}
+			if i == len(chars) {
+				return nil, fmt.Errorf("missing closing double quote")
+			}
+			if i == start {
+				return nil, fmt.Errorf("empty quoted regex")
+			}
+			plan.Patterns = append(plan.Patterns, string(chars[start:i]))
+			i++
+			if i < len(chars) && !unicode.IsSpace(chars[i]) {
+				return nil, fmt.Errorf("separate query terms with whitespace")
+			}
+		} else {
+			for i < len(chars) && !unicode.IsSpace(chars[i]) {
+				if chars[i] == '"' {
+					return nil, fmt.Errorf("double quotes must enclose a whole term")
+				}
+				i++
+			}
+			term := string(chars[start:i])
+			if fuzzyBare {
+				plan.Fuzzy = append(plan.Fuzzy, term)
+			} else {
+				plan.Patterns = append(plan.Patterns, regexp.QuoteMeta(term))
+			}
+		}
+	}
+	if _, err := CompilePlan(*plan); err != nil {
+		return nil, err
+	}
+	return plan, nil
+}
+
+const wordChars = `[\pL\pN\pM\pS_]`
+
+func FuzzyWordPattern(term string) string {
+	parts := make([]string, 0, len(term))
+	for _, r := range term {
+		parts = append(parts, regexp.QuoteMeta(string(r)))
+	}
+	return wordChars + "*" + strings.Join(parts, wordChars+"*") + wordChars + "*"
+}
+
+func FuzzyMatch(text, term string) bool {
+	want := []rune(strings.ToLower(term))
+	i := 0
+	if len(want) == 0 {
+		return true
+	}
+	for _, r := range strings.ToLower(text) {
+		if r == want[i] {
+			i++
+			if i == len(want) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func CompilePlan(plan QueryPlan) (MatcherFactory, error) {
+	patterns := append([]string{}, plan.Patterns...)
+	for _, term := range plan.Fuzzy {
+		patterns = append(patterns, FuzzyWordPattern(term))
+	}
+	compiled := make([]*regexp.Regexp, len(patterns))
+	for i, pattern := range patterns {
+		re, err := regexp.Compile("(?i)" + pattern)
+		if err != nil {
+			return nil, fmt.Errorf("invalid regex: %w", err)
+		}
+		compiled[i] = re
+	}
+	return func(id, label string) func(string) bool {
+		matched := make([]bool, len(compiled))
+		for i, term := range plan.Fuzzy {
+			matched[len(plan.Patterns)+i] = FuzzyMatch(id, term) || FuzzyMatch(label, term)
+		}
+		return func(body string) bool {
+			all := true
+			for i, re := range compiled {
+				if !matched[i] {
+					matched[i] = re.MatchString(body)
+				}
+				all = all && matched[i]
+			}
+			return all
+		}
+	}, nil
+}
+
+// Fuzzy preview highlights cover the matching word; regex highlights cover the
+// actual regex match. Both use the same patterns as the content filter.
+func HighlightPlan(plan QueryPlan) (*regexp.Regexp, error) {
+	var patterns []string
+	for _, pattern := range plan.Patterns {
+		if pattern != "" {
+			patterns = append(patterns, "(?:"+pattern+")")
+		}
+	}
+	for _, term := range plan.Fuzzy {
+		patterns = append(patterns, "(?:"+FuzzyWordPattern(term)+")")
+	}
+	if len(patterns) == 0 {
+		return nil, nil
+	}
+	return regexp.Compile("(?i)" + strings.Join(patterns, "|"))
+}
diff --git a/internal/grep/query_test.go b/internal/grep/query_test.go
new file mode 100644
index 0000000..4758d8e
--- /dev/null
+++ b/internal/grep/query_test.go
@@ -0,0 +1,83 @@
+package grep
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestParseQuotedAndMixedQuery(t *testing.T) {
+	for _, tc := range []struct {
+		raw             string
+		fuzzy           bool
+		patterns, terms []string
+		invalid         bool
+	}{
+		{raw: "mizu [fix]", fuzzy: true},
+		{raw: `"mizu|water"`, fuzzy: true, patterns: []string{"mizu|water"}},
+		{raw: `"\bmizu\b" dply`, fuzzy: true, patterns: []string{`\bmizu\b`}, terms: []string{"dply"}},
+		{raw: `dply "say \"hi\"" "💎"`, fuzzy: true, patterns: []string{`say \"hi\"`, "💎"}, terms: []string{"dply"}},
+		{raw: `"mizu" dply [fix]`, patterns: []string{"mizu", "dply", `\[fix\]`}},
+		{raw: `"" dply`, fuzzy: true, invalid: true},
+		{raw: `"["`, invalid: true},
+		{raw: `"mizu`, invalid: true},
+		{raw: `"mizu\"`, invalid: true},
+		{raw: `"mizu"dply`, invalid: true},
+	} {
+		plan, err := ParseQuery(tc.raw, tc.fuzzy)
+		if (err != nil) != tc.invalid {
+			t.Errorf("%q: plan=%v err=%v", tc.raw, plan, err)
+			continue
+		}
+		if tc.invalid {
+			continue
+		}
+		if tc.patterns == nil && tc.terms == nil {
+			if plan != nil {
+				t.Errorf("plain query should stay native/literal: %v", plan)
+			}
+			continue
+		}
+		if plan == nil || !reflect.DeepEqual(plan.Patterns, tc.patterns) || !reflect.DeepEqual(plan.Fuzzy, tc.terms) {
+			t.Errorf("%q: plan=%+v", tc.raw, plan)
+		}
+	}
+}
+
+func TestMixedQueryAccumulatesAcrossMessages(t *testing.T) {
+	factory, err := CompilePlan(QueryPlan{Patterns: []string{"mizu"}, Fuzzy: []string{"dply"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	match := factory("id", "neutral")
+	if match("mizu") {
+		t.Fatal("strict-only matched")
+	}
+	if !match("DEPLOY the change") {
+		t.Fatal("separate-message fuzzy condition did not match")
+	}
+	if factory("id", "mizu deploy")("neutral chat") {
+		t.Fatal("title satisfied chat-only regex")
+	}
+	if !factory("id", "deployment")("mizu") {
+		t.Fatal("title could not satisfy bare fuzzy term")
+	}
+	if !factory("d-e-p-l-o-y-id", "neutral")("mizu") {
+		t.Fatal("ID could not satisfy bare fuzzy term")
+	}
+	if factory("id", "neutral")("mizu: do prepare later yes") {
+		t.Fatal("chat subsequence crossed word boundaries")
+	}
+}
+
+func TestMixedHighlightMatchesFilterWords(t *testing.T) {
+	plan := QueryPlan{Patterns: []string{"mizu|water"}, Fuzzy: []string{"dply"}}
+	re, err := HighlightPlan(plan)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := re.FindAllString("Mizu deployment; do prepare later yes; water", -1)
+	if strings.Join(got, "|") != "Mizu|deployment|water" {
+		t.Fatalf("highlights=%q", got)
+	}
+}
