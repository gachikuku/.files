diff --git a/cmd/ccsession/picker_query.go b/cmd/ccsession/picker_query.go
new file mode 100644
index 0000000..02c32ab
--- /dev/null
+++ b/cmd/ccsession/picker_query.go
@@ -0,0 +1,92 @@
+package main
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"github.com/sorafujitani/ccsession/internal/grep"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// --exact preserves quote punctuation; normal and grep modes share the quoted
+// regex parser, with fuzzy bare terms enabled only outside strict grep mode.
+func pickerQuery(raw string, exact bool, prompt string) (*grep.QueryPlan, error) {
+	if exact {
+		return nil, nil
+	}
+	return grep.ParseQuery(raw, prompt != "grep   > ")
+}
+
+func pickerQueryToken(raw string) string {
+	value := raw + "\x00" + os.Getenv("FZF_PROMPT") + "\x00" + os.Getenv("CCSESSION_PICKER_EXACT")
+	return fmt.Sprintf("%x", sha256.Sum256([]byte(value)))
+}
+
+func pickerExact() bool { return os.Getenv("CCSESSION_PICKER_EXACT") == "1" }
+
+// fzf supplies query/state through the environment. User text is never inserted
+// into shell commands or fzf action syntax. Unquoted fuzzy edits do no data I/O.
+func cmdPickerAction(args []string) {
+	event := "change"
+	if len(args) > 0 {
+		event = args[0]
+	}
+	prompt := os.Getenv("FZF_PROMPT")
+	actions := []string{}
+	if event == "start" {
+		lines, _ := strconv.Atoi(os.Getenv("FZF_LINES"))
+		actions = append(actions, fmt.Sprintf("change-preview-window(up,%d,wrap,border-bottom)", max(1, lines-9)))
+	}
+	switch event {
+	case "grep":
+		prompt = "grep   > "
+		actions = append(actions, "change-prompt("+prompt+")")
+	case "dir":
+		prompt = "dir    > "
+		actions = append(actions, "change-prompt("+prompt+")", "change-nth(3)")
+	case "fuzzy":
+		prompt = "fuzzy  > "
+		if pickerExact() {
+			prompt = "literal> "
+		}
+		actions = append(actions, "change-prompt("+prompt+")", "change-nth(1,2,3,4,5)")
+	}
+	plan, err := pickerQuery(os.Getenv("FZF_QUERY"), pickerExact(), prompt)
+	if err != nil {
+		// Clear candidates rather than leave an old result selectable. Enter also
+		// runs this guard, including between an edit and its reload completing.
+		actions = append(actions, "change-header(Invalid regex or unclosed double quote)", "disable-search", "unbind(enter)")
+		if event != "ready" && event != "accept" {
+			actions = append(actions, "reload(printf '')")
+		}
+	} else if event == "accept" {
+		current := len(args) > 1 && strings.HasSuffix(args[1], "\t"+pickerQueryToken(os.Getenv("FZF_QUERY")))
+		if plan == nil && prompt != "grep   > " && os.Getenv("FZF_INPUT_STATE") == "disabled" {
+			actions = append(actions, "unbind(enter)", `reload-sync("$CCSESSION_BIN" list --color=always)`)
+		} else if (plan != nil || prompt == "grep   > ") && !current {
+			actions = append(actions, "unbind(enter)", `reload("$CCSESSION_BIN" list --color=always --picker-query)`)
+		} else {
+			actions = append(actions, "accept")
+		}
+	} else {
+		actions = append(actions, "change-header("+os.Getenv("CCSESSION_PICKER_HEADER")+")")
+		switch {
+		case event == "ready":
+			if plan == nil && prompt != "grep   > " {
+				actions = append(actions, "enable-search")
+			}
+			actions = append(actions, "rebind(enter)")
+		case plan != nil || prompt == "grep   > ":
+			actions = append(actions, "disable-search", `reload("$CCSESSION_BIN" list --color=always --picker-query)`)
+		case os.Getenv("FZF_INPUT_STATE") == "disabled" || event == "dir" || event == "fuzzy":
+			// Native filtering must wait for the complete corpus. Enabling it
+			// before an asynchronous reload lets rapid edits skip restoration
+			// while an older content-filtered reload is still queued.
+			actions = append(actions, `reload-sync("$CCSESSION_BIN" list --color=always)`)
+		default:
+			actions = append(actions, "rebind(enter)")
+		}
+	}
+	fmt.Println(strings.Join(actions, "+"))
+}
diff --git a/cmd/ccsession/picker_query_test.go b/cmd/ccsession/picker_query_test.go
new file mode 100644
index 0000000..32945fc
--- /dev/null
+++ b/cmd/ccsession/picker_query_test.go
@@ -0,0 +1,124 @@
+package main
+
+import (
+	"io"
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestPickerExactPreservesQuotes(t *testing.T) {
+	plan, err := pickerQuery(`"["`, true, "literal> ")
+	if err != nil || plan != nil {
+		t.Fatalf("exact query parsed as regex: %v %v", plan, err)
+	}
+}
+
+func pickerActionsForTest(t *testing.T, query, prompt, state string, args ...string) string {
+	t.Helper()
+	t.Setenv("FZF_QUERY", query)
+	t.Setenv("FZF_PROMPT", prompt)
+	t.Setenv("FZF_INPUT_STATE", state)
+	t.Setenv("CCSESSION_PICKER_HEADER", "Synthetic help")
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout := os.Stdout
+	os.Stdout = w
+	cmdPickerAction(args)
+	os.Stdout = stdout
+	w.Close()
+	out, err := io.ReadAll(r)
+	r.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(out)
+}
+
+func TestPickerStrictContentAndStaleSelection(t *testing.T) {
+	t.Setenv("CCSESSION_PICKER_EXACT", "0")
+	for _, query := range []string{`"mizu|water"`, "mizu [fix]"} {
+		prompt := "fuzzy  > "
+		if query[0] != '"' {
+			prompt = "grep   > "
+		}
+		got := pickerActionsForTest(t, query, prompt, "enabled", "change")
+		if !strings.Contains(got, "disable-search") || !strings.Contains(got, "--picker-query") {
+			t.Fatalf("content search used fzf fallback: %q", got)
+		}
+		stale := pickerActionsForTest(t, query, prompt, "disabled", "accept", "id\tlocator\t"+pickerQueryToken("previous"))
+		if strings.Contains(stale, "+accept") || strings.HasPrefix(stale, "accept") {
+			t.Fatalf("accepted stale results: %q", stale)
+		}
+		fresh := pickerActionsForTest(t, query, prompt, "disabled", "accept", "id\tlocator\t"+pickerQueryToken(query))
+		if !strings.Contains(fresh, "accept") {
+			t.Fatalf("rejected current result: %q", fresh)
+		}
+	}
+}
+
+func TestPickerInvalidRegexClearsResultsWithoutAccepting(t *testing.T) {
+	t.Setenv("CCSESSION_PICKER_EXACT", "0")
+	for _, event := range []string{"change", "accept", "ready"} {
+		got := pickerActionsForTest(t, `"["`, "fuzzy  > ", "disabled", event, "id\tlocator")
+		if !strings.Contains(got, "Invalid regex") || strings.Contains(got, "rebind(enter)") || strings.Contains(got, "+accept") {
+			t.Fatalf("invalid query actions: %q", got)
+		}
+		if event == "change" && !strings.Contains(got, "reload(printf '')") {
+			t.Fatalf("old results not cleared: %q", got)
+		}
+		if event == "ready" && strings.Contains(got, "reload(") {
+			t.Fatalf("empty reload loop: %q", got)
+		}
+	}
+}
+
+func TestPickerUnquotedFuzzyDoesNotReloadData(t *testing.T) {
+	t.Setenv("CCSESSION_PICKER_EXACT", "0")
+	got := pickerActionsForTest(t, "mizu", "fuzzy  > ", "enabled", "change")
+	if strings.Contains(got, "reload(") || strings.Contains(got, "disable-search") {
+		t.Fatalf("unquoted fuzzy read data: %q", got)
+	}
+	got = pickerActionsForTest(t, "mizu", "fuzzy  > ", "disabled", "change")
+	if !strings.Contains(got, "reload-sync(") || strings.Contains(got, "--picker-query") {
+		t.Fatalf("unquoting did not restore full fuzzy list: %q", got)
+	}
+}
+
+func TestPickerRestoresCorpusBeforeEnablingNativeSearch(t *testing.T) {
+	t.Setenv("CCSESSION_PICKER_EXACT", "0")
+	got := pickerActionsForTest(t, "case", "fuzzy  > ", "disabled", "change")
+	if !strings.Contains(got, "reload-sync(") || strings.Contains(got, "enable-search") || strings.Contains(got, "rebind(enter)") {
+		t.Fatalf("native search became ready before the full corpus arrived: %q", got)
+	}
+	got = pickerActionsForTest(t, "case", "fuzzy  > ", "disabled", "ready")
+	if !strings.Contains(got, "enable-search") || !strings.Contains(got, "rebind(enter)") {
+		t.Fatalf("completed native corpus did not enable search: %q", got)
+	}
+	got = pickerActionsForTest(t, "case", "fuzzy  > ", "disabled", "accept", "old-content-row")
+	if strings.Contains(got, "+accept") || strings.HasPrefix(got, "accept") {
+		t.Fatalf("accepted a row before the native corpus arrived: %q", got)
+	}
+}
+
+func TestPickerModeChangeCannotAcceptOldMixedRows(t *testing.T) {
+	t.Setenv("CCSESSION_PICKER_EXACT", "0")
+	t.Setenv("FZF_PROMPT", "fuzzy  > ")
+	query := `"mizu" dply`
+	oldRow := "id\tlocator\t" + pickerQueryToken(query)
+	got := pickerActionsForTest(t, query, "grep   > ", "disabled", "accept", oldRow)
+	if strings.Contains(got, "+accept") || strings.HasPrefix(got, "accept") {
+		t.Fatalf("mode switch accepted old mixed result: %q", got)
+	}
+}
+
+func TestPickerQueryNeverBecomesActionCode(t *testing.T) {
+	t.Setenv("CCSESSION_PICKER_EXACT", "0")
+	query := `"mizu" $(touch /tmp/should-never-exist)`
+	got := pickerActionsForTest(t, query, "fuzzy  > ", "enabled", "change")
+	if strings.Contains(got, "touch") || strings.Contains(got, "mizu") {
+		t.Fatalf("query leaked into action syntax: %q", got)
+	}
+}
diff --git a/cmd/ccsession/picker_test.go b/cmd/ccsession/picker_test.go
new file mode 100644
index 0000000..f5662e8
--- /dev/null
+++ b/cmd/ccsession/picker_test.go
@@ -0,0 +1,116 @@
+package main
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/sorafujitani/ccsession/internal/config"
+)
+
+// Run the generated picker script with real fzf in noninteractive filter mode.
+// Its input is synthetic, and resume only records its arguments. This checks
+// fzf's transformed search fields and unchanged output identity together.
+func TestPickerSearchWithFzf(t *testing.T) {
+	fzf, err := exec.LookPath("fzf")
+	if err != nil {
+		t.Skip("fzf is not installed")
+	}
+	const id = "019a1b2c-3d4e-75f6-8890-abcde1234567"
+	const locator = "codex:locator-one"
+	row := strings.Join([]string{id, locator, "1720000000", "2h ago", "my-project", "Ship !fix | v2.0 [rc] $cash $(touch injected) café", "Original"}, "\t")
+	other := strings.Join([]string{"019f0e9d-8c7b-6a54-3210-fedcb9876543", "codex:locator-two", "1720000001", "1h ago", "another-project", "Ship fix v2x0 rc cash my-project", "Fork"}, "\t")
+	cases := []struct {
+		name  string
+		query string
+		exact bool
+		nth   string
+		match bool
+	}{
+		{name: "fuzzy ID subsequence", query: "a1b2c75f68890", match: true},
+		{name: "fuzzy label", query: "Shp!fx", match: true},
+		{name: "literal ID case insensitive", query: "3D4E-75F6", exact: true, match: true},
+		{name: "literal label punctuation and spaces", query: "SHIP !fix | v2.0 [rc] $cash", exact: true, match: true},
+		{name: "literal spaces are significant", query: "Ship  !fix", exact: true},
+		{name: "literal fzf operators", query: "!fix |", exact: true, match: true},
+		{name: "literal accented text case insensitive", query: "CAFÉ", exact: true, match: true},
+		{name: "literal accents are significant", query: "cafe", exact: true},
+		{name: "query shell syntax is data", query: "$(touch injected)", exact: true, match: true},
+		{name: "directory excludes matching labels", query: "my-project", nth: "3", match: true},
+		{name: "literal directory case insensitive", query: "MY-PROJECT", exact: true, nth: "3", match: true},
+		{name: "directory excludes IDs", query: "a1b2c75f68890", nth: "3"},
+		{name: "ID is a separate fourth display field", query: "a1b2c75f68890", nth: "4", match: true},
+		{name: "ID does not merge into label", query: "a1b2c75f68890", nth: "5"},
+		{name: "hidden locator is not searchable", query: "locator-one"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			write := func(name, body string, mode os.FileMode) string {
+				t.Helper()
+				path := filepath.Join(dir, name)
+				if err := os.WriteFile(path, []byte(body), mode); err != nil {
+					t.Fatal(err)
+				}
+				return path
+			}
+			rows := write("rows.tsv", row+"\n"+other+"\n", 0600)
+			selected := filepath.Join(dir, "selected.tsv")
+			resumed := filepath.Join(dir, "resumed.txt")
+			bin := write("ccsession", `#!/bin/bash
+case "$1" in
+  list) cat "$PICKER_ROWS" ;;
+  resume) printf '%s\n' "$@" > "$PICKER_RESUMED" ;;
+  *) exit 2 ;;
+esac
+`, 0700)
+			write("fzf", `#!/bin/bash
+if [ -n "$PICKER_NTH" ]; then
+  set -- "$@" --nth="$PICKER_NTH"
+fi
+"$REAL_FZF" "$@" --filter="$CCSESSION_QUERY" > "$PICKER_SELECTED"
+result=$?
+cat "$PICKER_SELECTED"
+exit "$result"
+`, 0700)
+			cmd := exec.Command("bash", "-c", buildScript(config.Defaults(), "codex", tc.exact))
+			cmd.Dir = dir
+			cmd.Env = append(os.Environ(),
+				"PATH="+dir+string(os.PathListSeparator)+os.Getenv("PATH"),
+				"REAL_FZF="+fzf, "FZF_DEFAULT_OPTS=", "FZF_DEFAULT_OPTS_FILE=",
+				"CCSESSION_BIN="+bin, "CCSESSION_QUERY="+tc.query, "CCSESSION_EXCLUDE_DIR=",
+				"PICKER_ROWS="+rows, "PICKER_SELECTED="+selected, "PICKER_RESUMED="+resumed, "PICKER_NTH="+tc.nth,
+			)
+			if out, err := cmd.CombinedOutput(); err != nil {
+				t.Fatalf("picker failed: %v\n%s", err, out)
+			}
+			got, err := os.ReadFile(selected)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := ""
+			if tc.match {
+				want = row + "\n"
+			}
+			if string(got) != want {
+				t.Fatalf("selected row = %q, want %q", got, want)
+			}
+			got, err = os.ReadFile(resumed)
+			if tc.match {
+				if err != nil {
+					t.Fatal(err)
+				}
+				if want := "resume\n--locator\n" + locator + "\n" + id + "\n"; string(got) != want {
+					t.Errorf("resume arguments = %q, want %q", got, want)
+				}
+			} else if !os.IsNotExist(err) {
+				t.Errorf("empty selection should not resume, got %q, error %v", got, err)
+			}
+			if _, err := os.Stat(filepath.Join(dir, "injected")); !os.IsNotExist(err) {
+				t.Error("query was interpreted as shell syntax")
+			}
+		})
+	}
+}
diff --git a/internal/codex/chat.go b/internal/codex/chat.go
new file mode 100644
index 0000000..9364c2e
--- /dev/null
+++ b/internal/codex/chat.go
@@ -0,0 +1,145 @@
+package codex
+
+import (
+	"encoding/json"
+	"strings"
+	"time"
+
+	"github.com/sorafujitani/ccsession/internal/session"
+)
+
+type chatPayload struct {
+	Type      string          `json:"type"`
+	Role      string          `json:"role"`
+	Phase     string          `json:"phase"`
+	Channel   string          `json:"channel"`
+	Recipient string          `json:"recipient"`
+	Text      string          `json:"text"`
+	Message   string          `json:"message"`
+	Content   json.RawMessage `json:"content"`
+	Item      json.RawMessage `json:"item"`
+	Metadata  struct {
+		Kinds []string `json:"content_item_kinds"`
+	} `json:"internal_chat_message_metadata_passthrough"`
+}
+
+// The bool distinguishes supported chat items from an unknown projection.
+// Recognized instructions/analysis return an empty body, not a raw fallback.
+func parseChatPayload(raw json.RawMessage, itemType string, ts time.Time) (session.Message, bool) {
+	var p chatPayload
+	if err := json.Unmarshal(raw, &p); err != nil {
+		return session.Message{}, false
+	}
+	if p.Type == "item_completed" {
+		if err := json.Unmarshal(p.Item, &p); err != nil {
+			return session.Message{}, false
+		}
+	}
+	if p.Type == "" {
+		p.Type = itemType
+	}
+	role := p.Role
+	switch p.Type {
+	case "message":
+		if role != "user" && role != "assistant" {
+			return session.Message{}, false
+		}
+	case "UserMessage", "userMessage", "user_message":
+		role = "user"
+	case "AgentMessage", "agentMessage", "agent_message":
+		role = "assistant"
+	default:
+		return session.Message{}, false
+	}
+	msg := session.Message{Role: role, Timestamp: ts}
+	if role == "assistant" {
+		for _, phase := range []string{p.Channel, p.Phase} {
+			if phase != "" && phase != "commentary" && phase != "final" && phase != "final_answer" {
+				return msg, true
+			}
+		}
+		if p.Recipient != "" && p.Recipient != "all" {
+			return msg, true
+		}
+	}
+	canonicalUser := p.Type == "UserMessage" || p.Type == "userMessage"
+	clean := func(text, kind string) string {
+		if role == "user" && (strings.HasPrefix(kind, "agents_md.") || strings.HasPrefix(kind, "environments.")) {
+			return ""
+		}
+		if role != "user" || canonicalUser || kind == "user.text" {
+			return text
+		}
+		return userVisibleBody(text)
+	}
+	var body string
+	if len(p.Content) > 0 {
+		var text string
+		if json.Unmarshal(p.Content, &text) == nil {
+			body = clean(text, "")
+		} else {
+			var blocks []struct {
+				Type string `json:"type"`
+				Text string `json:"text"`
+			}
+			if json.Unmarshal(p.Content, &blocks) != nil {
+				return session.Message{}, false
+			}
+			var parts []string
+			for i, block := range blocks {
+				if block.Type != "" && block.Type != "text" && block.Type != "Text" && block.Type != "input_text" && block.Type != "output_text" {
+					continue
+				}
+				kind := ""
+				if len(p.Metadata.Kinds) == len(blocks) {
+					kind = p.Metadata.Kinds[i]
+				}
+				if text := clean(block.Text, kind); text != "" {
+					parts = append(parts, text)
+				}
+			}
+			body = strings.Join(parts, "\n")
+		}
+	} else if p.Text != "" {
+		body = clean(p.Text, "")
+	} else {
+		body = clean(p.Message, "")
+	}
+	msg.Body = strings.TrimSpace(body)
+	return msg, true
+}
+
+func userVisibleBody(body string) string {
+	body = strings.TrimSpace(body)
+	for {
+		if strings.HasPrefix(body, "# AGENTS.md instructions") && strings.Contains(body, "<INSTRUCTIONS>") {
+			_, after, ok := strings.Cut(body, "</INSTRUCTIONS>")
+			if !ok {
+				return ""
+			}
+			body = strings.TrimSpace(after)
+			continue
+		}
+		stripped := false
+		for _, tag := range []string{"environment_context", "system_reminder", "subagent_notification", "agent_notification", "developer_instructions", "user_instructions", "INSTRUCTIONS"} {
+			if !strings.HasPrefix(body, "<"+tag+">") && !strings.HasPrefix(body, "<"+tag+" ") {
+				continue
+			}
+			_, after, ok := strings.Cut(body, "</"+tag+">")
+			if !ok {
+				return ""
+			}
+			body, stripped = strings.TrimSpace(after), true
+			break
+		}
+		if !stripped {
+			break
+		}
+	}
+	if strings.HasPrefix(body, "# Context from my IDE setup:") || strings.HasPrefix(body, "# Files mentioned by the user:") || strings.HasPrefix(body, "## My request for Codex:") {
+		if _, after, ok := strings.Cut(body, "## My request for Codex:"); ok {
+			return strings.TrimSpace(after)
+		}
+	}
+	return body
