+			t.Setenv(grep.EnvCacheDir, t.TempDir())
+			home := t.TempDir()
+			var state, history *sql.DB
+			if projected {
+				state = testIndexDB(t, home, "state_5.sqlite", testStateSchema)
+				history = testIndexDB(t, home, "thread_history_1.sqlite", `CREATE TABLE thread_items (thread_id TEXT, rollout_ordinal INTEGER, item_type TEXT, item_json TEXT)`)
+			}
+			for _, tc := range []struct {
+				id, title string
+				messages  []string
+				want      bool
+			}{
+				{"same", "neutral", []string{"mizu deployment"}, true},
+				{"separate", "neutral", []string{"mizu question", "deploy the answer"}, true},
+				{"strict-only", "neutral", []string{"mizu", "distant people like yellow"}, false},
+				{"fuzzy-only", "neutral", []string{"deploy"}, false},
+				{"title", "deploy discussion", []string{"mizu"}, true},
+				{"deploy-id", "neutral", []string{"mizu"}, true},
+				{"title-only", "mizu deploy", []string{"nothing relevant"}, false},
+			} {
+				var lines []string
+				meta, _ := json.Marshal(map[string]any{"type": "session_meta", "payload": map[string]string{"id": tc.id, "cwd": home}})
+				lines = append(lines, string(meta))
+				for i, body := range tc.messages {
+					payload := map[string]any{"type": "message", "role": "assistant", "content": body}
+					raw, _ := json.Marshal(map[string]any{"type": "response_item", "payload": payload})
+					lines = append(lines, string(raw))
+					if projected {
+						raw, _ := json.Marshal(map[string]any{"text": body})
+						if _, err := history.Exec("INSERT INTO thread_items VALUES (?, ?, 'agentMessage', ?)", tc.id, i, string(raw)); err != nil {
+							t.Fatal(err)
