+package codex
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestIndexedForkMetadataAndSubagentSources(t *testing.T) {
+	home := t.TempDir()
+	db := testIndexDB(t, home, "state_5.sqlite", testStateSchema)
+	for _, tc := range []struct{ id, fields, source, want, parent string }{
+		{"original", `"source":"cli"`, "cli", "Original", ""},
+		{"fork", `"source":"cli","forked_from_id":"original"`, "cli", "Fork", "original"},
+		{"nested", `"source":"cli","forked_from_id":"fork"`, "cli", "Fork", "fork"},
+		{"header-child", `"source":{"subagent":{"thread_spawn":{"parent_thread_id":"original"}}}`, "cli", "", ""},
+		{"source-child", `"source":"cli"`, `{"subagent":{"thread_spawn":{"parent_thread_id":"original"}}}`, "", ""},
+		{"string-child", `"source":"cli"`, "subagent", "", ""},
+		{"missing", "", "cli", "Unknown", ""},
+		{"mismatch", `"source":"cli","forked_from_id":"original"`, "cli", "Unknown", ""},
+	} {
+		path := testIndexThread(t, db, home, tc.id, "Synthetic label")
+		if _, err := db.Exec(`UPDATE threads SET source=? WHERE id=?`, tc.source, tc.id); err != nil {
+			t.Fatal(err)
+		}
+		metaID := tc.id
+		if tc.id == "mismatch" {
+			metaID = "other-id"
+		}
+		if tc.fields != "" && tc.id != "source-child" {
+			body := `{"type":"session_meta","payload":{"id":"` + metaID + `",` + tc.fields + `}}` + "\n" + strings.Repeat("not a transcript\n", 100)
+			if err := os.WriteFile(path, []byte(body), 0600); err != nil {
+				t.Fatal(err)
+			}
+		} else if err := os.Remove(path); err != nil {
+			t.Fatal(err)
+		}
+		sessions, ok := OpenAt(home).indexedSessions(tc.id)
+		if !ok {
+			t.Fatal("index fell back to JSONL")
+		}
+		if tc.want == "" {
+			if len(sessions) != 0 {
+				t.Errorf("%s: listed subagent", tc.id)
+			}
+			continue
+		}
+		if len(sessions) != 1 {
+			t.Fatalf("%s: got %d sessions", tc.id, len(sessions))
+		}
+		sessions[0].Source = "codex" // normally supplied by the source adapter
+		if got := sessions[0]; got.ForkType() != tc.want || got.ForkedFromID != tc.parent {
+			t.Errorf("%s: type=%q parent=%q", tc.id, got.ForkType(), got.ForkedFromID)
+		}
+	}
+}
+
+func TestMetadataReadIsBounded(t *testing.T) {
+	const header = `{"type":"session_meta","payload":{"id":"original","source":"cli"}}`
+	for _, prefix := range []string{strings.Repeat("x", 1<<20), strings.Repeat("{}\n", 16)} {
+		path := filepath.Join(t.TempDir(), "rollout.jsonl")
+		if err := os.WriteFile(path, []byte(prefix+"\n"+header+"\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if _, known := readSessionMetadata(path); known {
+			t.Fatal("read metadata beyond bounded header")
+		}
+	}
+}
