+			keys, err := OpenAt(home).QueryKeys(grep.QueryPlan{Patterns: []string{"mizu", "answer"}, Fuzzy: []string{"dply"}})
+			if _, hit := keys["separate"]; err != nil || !hit || len(keys) != 1 {
+				t.Fatalf("multiple independent chat constraints: keys=%v err=%v", keys, err)
+			}
+		})
+	}
