+func TestModernEventGrepFallbackAndMirroredPreview(t *testing.T) {
+	t.Setenv(grep.EnvCacheDir, t.TempDir())
+	home := t.TempDir()
+	id := "019ec14c-b49c-7a40-a386-0a1699dbb01c"
+	lines := []string{
+		`{"type":"session_meta","payload":{"id":"` + id + `","cwd":"` + home + `"}}`,
+		`{"type":"response_item","payload":{"type":"message","role":"user","content":"neutral question"}}`,
+		`{"type":"event_msg","payload":{"type":"item_completed","item":{"type":"UserMessage","content":[{"type":"text","text":"neutral question"}]}}}`,
+		`{"type":"event_msg","payload":{"type":"item_completed","item":{"type":"AgentMessage","phase":"final_answer","content":[{"type":"Text","text":"MIZU literal.[x] answer"}]}}}`,
+		`{"type":"response_item","payload":{"type":"message","role":"assistant","channel":"analysis","content":"hidden-analysis-only"}}`,
+		`{"type":"event_msg","payload":{"type":"item_completed","item":{"type":"CommandExecution","text":"hidden-tool-only"}}}`,
+		`{"type":"event_msg","payload":{"type":"task_complete"}}`,
+		`{"type":"event_msg","payload":{"type":"item_completed","item":{"type":"UserMessage","content":[{"type":"text","text":"neutral question"}]}}}`,
