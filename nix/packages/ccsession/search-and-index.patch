+// Codex evaluates every condition in one indexed-history pass. Other backends
+// retain their existing grep adapters, intersecting each required condition.
+func loadQuerySessions(src source.Source, plan grep.QueryPlan) ([]*session.Session, error) {
+	if qs, ok := src.(interface {
+		QueryKeys(grep.QueryPlan) (map[string]struct{}, error)
+	}); ok {
+		allow, err := qs.QueryKeys(plan)
+		if err != nil {
+			return nil, err
+		}
+		if len(allow) == 0 {
+			return nil, nil
+		}
+		return src.ScanFiltered(allow)
+	}
+	sessions, err := src.Scan()
+	if err != nil {
+		return nil, err
+	}
+	patterns := append([]string{}, plan.Patterns...)
+	for _, term := range plan.Fuzzy {
+		patterns = append(patterns, grep.FuzzyWordPattern(term))
+	}
+	for i, pattern := range patterns {
+		allow, err := src.GrepKeys(pattern, true)
+		if err != nil {
+			return nil, err
+		}
+		matched := make(map[string]bool)
+		if len(allow) > 0 {
+			filtered, err := src.ScanFiltered(allow)
+			if err != nil {
+				return nil, err
+			}
+			for _, sess := range filtered {
+				matched[source.LocatorFor(sess)] = true
+			}
+		}
+		kept := sessions[:0]
+		for _, sess := range sessions {
+			match := matched[source.LocatorFor(sess)]
+			if i >= len(plan.Patterns) {
+				term := plan.Fuzzy[i-len(plan.Patterns)]
+				match = match || grep.FuzzyMatch(sess.ID, term) || grep.FuzzyMatch(sess.Label, term)
