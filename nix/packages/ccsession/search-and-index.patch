+func TestChatPayloadKeepsOnlyVisibleText(t *testing.T) {
+	for _, tc := range []struct {
+		name, raw, want string
+	}{
+		{"canonical user", `{"type":"item_completed","item":{"type":"UserMessage","content":[{"type":"text","text":"mizu"},{"type":"local_image","text":"hidden"}]}}`, "mizu"},
+		{"canonical assistant", `{"type":"item_completed","item":{"type":"AgentMessage","phase":"final_answer","content":[{"type":"Text","text":"mizu reply"}]}}`, "mizu reply"},
+		{"legacy event", `{"type":"agent_message","message":"mizu legacy reply"}`, "mizu legacy reply"},
+		{"analysis", `{"type":"message","role":"assistant","channel":"analysis","content":[{"type":"output_text","text":"hidden"}]}`, ""},
+		{"tool recipient", `{"type":"message","role":"assistant","recipient":"tools.exec","content":"hidden"}`, ""},
+		{"context then request", `{"type":"message","role":"user","content":"<environment_context>hidden</environment_context>\nmizu request"}`, "mizu request"},
+		{"ordinary mention", `{"type":"message","role":"user","content":"Please explain AGENTS.md and <INSTRUCTIONS> here"}`, "Please explain AGENTS.md and <INSTRUCTIONS> here"},
+		{"metadata blocks", `{"type":"message","role":"user","content":[{"type":"input_text","text":"hidden"},{"type":"input_text","text":"# AGENTS.md instructions for example\n<INSTRUCTIONS>genuine text</INSTRUCTIONS>"}],"internal_chat_message_metadata_passthrough":{"content_item_kinds":["agents_md.instructions","user.text"]}}`, "# AGENTS.md instructions for example\n<INSTRUCTIONS>genuine text</INSTRUCTIONS>"},
+		{"canonical metadata blocks", `{"type":"userMessage","content":[{"type":"text","text":"hidden instructions"},{"type":"text","text":"hidden environment"},{"type":"text","text":"mizu actual request"}],"internal_chat_message_metadata_passthrough":{"content_item_kinds":["agents_md.instructions","environments.environment_context","user.text"]}}`, "mizu actual request"},
+		{"canonical quoted example", `{"type":"userMessage","content":[{"type":"text","text":"# AGENTS.md instructions for example\n<INSTRUCTIONS>genuine pasted text</INSTRUCTIONS>"}]}`, "# AGENTS.md instructions for example\n<INSTRUCTIONS>genuine pasted text</INSTRUCTIONS>"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			msg, ok := parseChatPayload(json.RawMessage(tc.raw), "", time.Time{})
+			if !ok || msg.Body != tc.want {
+				t.Fatalf("body=%q supported=%v, want %q", msg.Body, ok, tc.want)
+			}
+		})
+	}
+}
