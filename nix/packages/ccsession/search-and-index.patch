+ thread_id TEXT, rollout_ordinal INTEGER, item_type TEXT, item_json TEXT, created_at_ms INTEGER)`)
+	quoted := "# AGENTS.md instructions for a pasted example\n<INSTRUCTIONS>mizu actual user text</INSTRUCTIONS>"
+	user, _ := json.Marshal(map[string]any{"type": "userMessage", "content": []map[string]string{{"type": "text", "text": quoted}}})
+	for i, item := range []struct{ typ, raw string }{
+		{"userMessage", string(user)},
+		{"agentMessage", `{"text":"visible reply","phase":"final_answer"}`},
+		{"agentMessage", `{"text":"hidden analysis","phase":"analysis"}`},
+		{"agentMessage", `{"text":"hidden tool recipient","recipient":"tools.exec"}`},
+	} {
+		if _, err := history.Exec("INSERT INTO thread_items VALUES ('thread', ?, ?, ?, ?)", i, item.typ, item.raw, i*1000); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, limit := range []int{0, 2} {
+		msgs, _, _, err := OpenAt(home).Messages("thread", limit)
+		if err != nil || len(msgs) != 2 || msgs[0].Body != quoted || msgs[1].Body != "visible reply" {
+			t.Fatalf("limit=%d visible indexed chat=%+v err=%v", limit, msgs, err)
+		}
+	}
+}
+
+func TestIndexMissingOrUnsupportedFallsBackToJSONL(t *testing.T) {
+	for _, unsupported := range []bool{false, true} {
+		t.Run(map[bool]string{false: "missing", true: "unsupported"}[unsupported], func(t *testing.T) {
+			home, _, id := fixture(t)
+			if unsupported {
+				testIndexDB(t, home, "state_5.sqlite", "CREATE TABLE other (id TEXT)")
+			}
+			store := OpenAt(home)
+			ss, err := store.Scan()
+			if err != nil || len(ss) != 1 || ss[0].ID != id {
+				t.Fatalf("fallback Scan: got=%+v err=%v", ss, err)
+			}
+			msgs, _, total, err := store.Messages(id, 1)
+			if err != nil || len(msgs) != 1 || total != 3 {
+				t.Fatalf("fallback Messages: got=%+v total=%d err=%v", msgs, total, err)
+			}
+			if !unsupported {
+				files, _ := filepath.Glob(filepath.Join(home, "*.sqlite"))
+				if len(files) != 0 {
+					t.Fatalf("missing index was created: %v", files)
+				}
+			}
+		})
+	}
+}
+
+func TestIndexedMetadataPreservesRawGrepFallback(t *testing.T) {
+	t.Setenv(grep.EnvCacheDir, t.TempDir())
+	home, cwd, id := fixture(t)
+	store := OpenAt(home)
+	old, err := store.FindByID(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	db := testIndexDB(t, home, "state_5.sqlite", testStateSchema)
+	if _, err := db.Exec(`INSERT INTO threads (id, rollout_path, cwd, title, updated_at) VALUES (?, ?, ?, 'renamed', 123)`, id, old.JSONLPath, cwd); err != nil {
+		t.Fatal(err)
+	}
+	for _, query := range []string{"assistant answer"} {
+		keys, err := store.GrepKeys(query, false)
+		if _, ok := keys[id]; err != nil || !ok {
+			t.Fatalf("GrepKeys(%q): keys=%v err=%v", query, keys, err)
+		}
+	}
+	if keys, err := store.GrepKeys("renamed", false); err != nil || len(keys) != 0 {
+		t.Fatalf("metadata label matched chat grep: keys=%v err=%v", keys, err)
+	}
+	msgs, _, total, err := store.Messages(id, 1)
+	if err != nil || total != 3 || len(msgs) != 1 {
+		t.Fatalf("missing history JSONL fallback: msgs=%+v total=%d err=%v", msgs, total, err)
+	}
+}
+
+func TestIndexConnectionsAreReadOnlyAndReadWAL(t *testing.T) {
+	home := t.TempDir()
+	db := testIndexDB(t, home, "state_5.sqlite", testStateSchema)
+	if _, err := db.Exec("PRAGMA journal_mode=WAL"); err != nil {
+		t.Fatal(err)
+	}
+	testIndexThread(t, db, home, "thread", "WAL label")
+	reader, err := openIndex(home, "state")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	if _, err := reader.Exec("UPDATE threads SET name='should fail'"); err == nil || !strings.Contains(strings.ToLower(err.Error()), "readonly") {
+		t.Fatalf("write was not rejected as read-only: %v", err)
+	}
+	ss, err := OpenAt(home).Scan()
+	if err != nil || len(ss) != 1 || ss[0].Label != "WAL label" || !ss[0].LastTime.Equal(time.UnixMilli(300123)) {
+		t.Fatalf("WAL sessions: %+v err=%v", ss, err)
+	}
+}
diff --git a/internal/codex/metadata.go b/internal/codex/metadata.go
new file mode 100644
index 0000000..ed35672
--- /dev/null
+++ b/internal/codex/metadata.go
@@ -0,0 +1,57 @@
+package codex
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"io"
+	"os"
+	"strings"
+)
+
+// Lineage is in the rollout header, not Codex's state database. Limit reads
+// independently of transcript size; normal fuzzy keystrokes stay inside fzf.
+func readSessionMetadata(path string) (sessionMetaPayload, bool) {
+	f, err := os.Open(path)
+	if err != nil {
+		return sessionMetaPayload{}, false
+	}
+	defer f.Close()
+	r := bufio.NewReader(io.LimitReader(f, 1<<20))
+	for range 16 {
+		line, err := r.ReadBytes('\n')
+		var e entry
+		if json.Unmarshal(line, &e) == nil && e.Type == "session_meta" {
+			var meta sessionMetaPayload
+			if json.Unmarshal(e.Payload, &meta) == nil {
+				return meta, true
+			}
+		}
+		if err != nil {
+			break
+		}
+	}
+	return sessionMetaPayload{}, false
+}
+
+func (m sessionMetaPayload) isSubagent() bool {
+	if m.ParentThreadID != "" || (m.AgentPath != "" && m.AgentPath != "/root") {
+		return true
+	}
+	var source struct {
+		Subagent json.RawMessage `json:"subagent"`
+	}
+	if json.Unmarshal(m.Source, &source) == nil && len(source.Subagent) > 0 && !bytes.Equal(source.Subagent, []byte("null")) {
+		return true
+	}
+	var kind string
+	return json.Unmarshal(m.Source, &kind) == nil && kind == "subagent"
+}
+
+func cleanForkID(id string) string {
+	id = strings.TrimSpace(id)
+	if idCorruptsRow(id) {
+		return ""
+	}
+	return id
+}
