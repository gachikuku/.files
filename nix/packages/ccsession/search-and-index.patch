+++ b/internal/preview/search.go
@@ -0,0 +1,80 @@
+package preview
+
+import (
+	"regexp"
+	"unicode/utf8"
+
+	"github.com/sorafujitani/ccsession/internal/grep"
+	"github.com/sorafujitani/ccsession/internal/session"
+)
+
+func previewLoadLimit(opts Options) int {
+	if compileHighlight(opts, colors{}) != nil {
+		return 0
+	}
+	return messageLimit(opts)
+}
+
+func messageWindow(messages []session.Message, opts Options) []session.Message {
+	limit := messageLimit(opts)
+	if len(messages) <= limit {
+		return messages
+	}
+	match := compileHighlight(opts, colors{})
+	// Prioritize the required chat expression over an incidental fuzzy word.
+	if opts.QueryPlan != nil {
+		match, _ = grep.HighlightPlan(grep.QueryPlan{Patterns: opts.QueryPlan.Patterns})
+	}
+	if match != nil {
+		for i := len(messages) - 1; i >= 0; i-- {
+			if match.MatchString(messages[i].Body) {
+				start := min(max(0, i-limit/2), len(messages)-limit)
+				return messages[start : start+limit]
+			}
+		}
+	}
+	return messages[len(messages)-limit:]
+}
+
+// Keep a bounded excerpt around the first positive match, even on a later
+// line. Match offsets come from the original body so clipped long matches and
+// anchors still highlight correctly after adding ellipses.
+func bodySnippet(body string, re *regexp.Regexp) (string, [][]int) {
+	if re == nil {
+		return truncateBody(body), nil
+	}
+	matches := re.FindAllStringIndex(body, -1)
+	first := -1
+	for i, match := range matches {
+		if match[1] > match[0] {
+			first = i
+			break
+		}
+	}
+	if first < 0 {
+		return truncateBody(body), nil
+	}
+	chars := []rune(body)
+	at := utf8.RuneCountInString(body[:matches[first][0]])
+	start := max(0, at-maxBodyLen/3)
+	end := min(len(chars), start+maxBodyLen)
+	start = min(start, max(0, end-maxBodyLen))
+	byteStart, byteEnd := len(string(chars[:start])), len(string(chars[:end]))
+	snippet := body[byteStart:byteEnd]
+	prefix := 0
+	if start > 0 {
+		snippet = "…" + snippet
+		prefix = len("…")
+	}
+	if end < len(chars) {
+		snippet += "…"
+	}
+	var visible [][]int
+	for _, match := range matches {
+		lo, hi := max(byteStart, match[0]), min(byteEnd, match[1])
+		if hi > lo {
+			visible = append(visible, []int{lo - byteStart + prefix, hi - byteStart + prefix})
+		}
+	}
+	return snippet, visible
+}
