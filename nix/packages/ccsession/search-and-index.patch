+	home := t.TempDir()
+	db := testIndexDB(t, home, "state_5.sqlite", testStateSchema)
+	for _, id := range []string{"renamed", "title", "first", "archive", "subagent", "exec", "originator"} {
+		testIndexThread(t, db, home, id, "new name")
+	}
+	for _, q := range []string{
+		`UPDATE threads SET name='', recency_at_ms=0, updated_at_ms=400123 WHERE id='title'`,
+		`UPDATE threads SET name=NULL, title='', recency_at_ms=NULL, updated_at_ms=NULL, updated_at=500 WHERE id='first'`,
+		`UPDATE threads SET archived=1 WHERE id='archive'`,
+		`UPDATE threads SET agent_path='root/child' WHERE id='subagent'`,
+		`UPDATE threads SET source='exec' WHERE id='exec'`,
+		`UPDATE threads SET originator='codex_exec' WHERE id='originator'`,
+	} {
+		if _, err := db.Exec(q); err != nil {
+			t.Fatal(err)
+		}
+	}
+	calls := countParseCalls(t)
+	store := OpenAt(home)
+	ss, err := store.Scan()
+	if err != nil || len(ss) != 3 {
+		t.Fatalf("Scan: sessions=%v err=%v", ss, err)
+	}
+	if got := []string{ss[0].ID, ss[1].ID, ss[2].ID}; !reflect.DeepEqual(got, []string{"first", "title", "renamed"}) {
+		t.Fatalf("recency order = %v", got)
+	}
+	if ss[0].Label != "first message" || ss[1].Label != "old title" || ss[2].Label != "new name" {
+		t.Fatalf("label priority = %q, %q, %q", ss[0].Label, ss[1].Label, ss[2].Label)
+	}
+	got, err := store.FindByID("renamed")
+	if err != nil || got.CWD != home || !got.CWDExists || got.CWDUnknown {
+		t.Fatalf("FindByID: got=%+v err=%v", got, err)
+	}
+	located, err := store.FindByLocator(got.ID, got.JSONLPath)
+	if err != nil || located.Label != "new name" {
+		t.Fatalf("FindByLocator: got=%+v err=%v", located, err)
+	}
+	if calls.Load() != 0 {
+		t.Fatalf("indexed metadata parsed JSONL %d times", calls.Load())
+	}
+	if _, err := db.Exec(`UPDATE threads SET name='renamed again' WHERE id='renamed'`); err != nil {
+		t.Fatal(err)
+	}
+	got, err = store.FindByID("renamed")
+	if err != nil || got.Label != "renamed again" {
+		t.Fatalf("fresh rename: got=%+v err=%v", got, err)
+	}
+}
