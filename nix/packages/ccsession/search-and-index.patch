+					// across an assistant message cannot match through its title.
+					lines = append(lines, `{"type":"response_item","payload":{"type":"message","role":"user","content":"neutral"}}`)
+					writeSession(t, home, tc.id, strings.Join(lines, "\n")+"\n")
+				}
+				keys, err := OpenAt(home).QueryKeys(grep.QueryPlan{Patterns: []string{"mizu"}, Fuzzy: []string{"dply"}})
+				_, hit := keys[tc.id]
+				want := tc.want && (projected || tc.id != "title")
+				if err != nil || hit != want {
+					t.Fatalf("%s: hit=%v want=%v err=%v", tc.id, hit, want, err)
