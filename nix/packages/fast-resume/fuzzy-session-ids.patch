+fn id_text_query(fields: IndexFields, search_text: &str) -> Option<Box<dyn Query>> {
+    let search_text = search_text.trim();
+    // Keep broad, single-character matches and unbounded automata out of the
+    // interactive path. UUIDs and 64-character IDs fit without reindexing.
+    if !(3..=64).contains(&search_text.chars().count())
+        || search_text.split_whitespace().count() != 1
+    {
+        return None;
+    }
+
+    let literal = regex::escape(search_text);
+    let subsequence = search_text
+        .chars()
+        .map(|ch| {
+            let literal = regex::escape(&ch.to_string());
+            format!("[^{literal}]*{literal}")
+        })
+        .collect::<String>();
+    let mut alternatives: Vec<(Occur, Box<dyn Query>)> = Vec::new();
+    // These query the existing raw ID term dictionary, never stored content.
+    // Prefer stronger ID matches while preserving normal text relevance.
+    for (pattern, boost) in [
+        (format!("(?i){literal}"), 25.0),
+        (format!("(?i).*{literal}.*"), 8.0),
+        // Matching each next character at its first occurrence is equivalent
+        // to .*a.*b, but avoids ambiguous gaps and expensive DFA construction.
+        (format!("(?i){subsequence}.*"), 1.0),
+    ] {
+        // Tantivy also bounds DFA size. A complex subsequence must not make
+        // the full-ID, contiguous-ID, or ordinary text query fail with it.
+        let Ok(query) = RegexQuery::from_pattern(&pattern, fields.id) else {
+            continue;
+        };
+        alternatives.push((
+            Occur::Should,
+            Box::new(BoostQuery::new(Box::new(query), boost)),
+        ));
+    }
+    Some(Box::new(BooleanQuery::new(alternatives)))
+}
