+#[test]
+fn json_search_matches_full_partial_and_fuzzy_metadata_ids() {
+    let temp = TempDir::new().unwrap();
+    let id = "019abcde-1234-5678-9abc-def012345678";
+    write_codex_session(temp.path(), id, "/repo/backend", "Neutral conversation");
+    write_codex_session(
+        temp.path(),
+        "unrelated",
+        "/repo/backend",
+        "Other conversation",
+    );
+    // Build once, then prove all ID forms work against the existing index.
+    assert_success(run_fr(temp.path(), &["--json"]));
+
+    for query in [
+        id,
+        "1234-5678",
+        "0ACE1359",
+        "agent:codex dir:backend date:<1d 0ACE1359",
+    ] {
+        let (stdout, _) = assert_success(run_fr(temp.path(), &["--json", "--no-refresh", query]));
+        let result: Value = serde_json::from_str(&stdout).unwrap();
+        assert_eq!(result["meta"]["total"], 1, "query: {query}");
+        assert_eq!(result["sessions"][0]["id"], id, "query: {query}");
+        assert_eq!(
+            result["sessions"][0]["resume_command"],
+            json!(["codex", "resume", id])
+        );
+    }
+}
+
+#[test]
+fn codex_forks_expose_their_source_and_resume_themselves_without_subagents() {
+    let temp = TempDir::new().unwrap();
+    for (id, parent) in [
+        ("original", None),
+        ("fork-one", Some("original")),
+        ("fork-two", Some("fork-one")),
+        ("child", Some("fork-one")),
+    ] {
+        let path = write_codex_session(temp.path(), id, "/repo/forks", "Shared prompt");
+        let mut metadata = json!({"id":id,"cwd":"/repo/forks","source":"cli"});
+        if let Some(parent) = parent {
+            metadata["forked_from_id"] = json!(parent);
+        }
+        if id == "child" {
+            metadata["source"] =
+                json!({"subagent":{"thread_spawn":{"parent_thread_id":"fork-one"}}});
+        }
+        write_jsonl(
+            &path,
+            &[
+                json!({"type":"session_meta","payload":metadata}),
+                json!({"type":"event_msg","payload":{"type":"user_message","message":"Shared prompt"}}),
+            ],
+        );
+    }
+    assert_success(run_fr(temp.path(), &["--json", "--all"]));
+    let (stdout, _) = assert_success(run_fr(temp.path(), &["--json", "--no-refresh", "--all"]));
+    let output: Value = serde_json::from_str(&stdout).unwrap();
+    assert_eq!(output["schema_version"], 1);
+    let sessions = output["sessions"].as_array().unwrap();
+    assert_eq!(sessions.len(), 3);
+    assert!(sessions.iter().all(|session| session["id"] != "child"));
+    for (id, parent) in [
+        ("original", None),
+        ("fork-one", Some("original")),
+        ("fork-two", Some("fork-one")),
+    ] {
+        let session = sessions.iter().find(|session| session["id"] == id).unwrap();
+        assert_eq!(
+            session.get("forked_from_id").and_then(Value::as_str),
+            parent
+        );
+        assert_eq!(session["resume_command"], json!(["codex", "resume", id]));
+        for internal in ["content", "mtime", "yolo"] {
+            assert!(session.get(internal).is_none());
+        }
+    }
+}
+
+#[test]
+fn cached_codex_subagent_routes_to_main_then_refresh_hides_it() {
+    let temp = TempDir::new().unwrap();
+    let root_id = "019abcde-1234-5678-9abc-def012345678";
+    let child_id = "019abcde-9876-5432-9abc-def087654321";
+    write_codex_session(temp.path(), root_id, "/repo/main", "Main request");
+    let child_path = write_codex_session(temp.path(), child_id, "/repo/worktree", "Child request");
+    assert_success(run_fr(temp.path(), &["--json", "--all"]));
+
+    // Simulate a cached child from a previous picker version: the persisted
+    // document has no ancestry, but Codex's durable header records its parent.
+    write_jsonl(
+        &child_path,
+        &[
+            json!({"type": "session_meta", "payload": {"id": child_id, "cwd": "/repo/worktree", "source": {"subagent": {"thread_spawn": {"parent_thread_id": root_id}}}}}),
+            json!({"type": "event_msg", "payload": {"type": "user_message", "message": "Child request"}}),
+        ],
+    );
+    let (stdout, _) = assert_success(run_fr(
+        temp.path(),
+        &["--json", "--no-refresh", "--limit", "1", child_id],
+    ));
+    let cached: Value = serde_json::from_str(&stdout).unwrap();
+    assert_eq!(cached["sessions"][0]["id"], child_id);
+    assert_eq!(
+        cached["sessions"][0]["resume_command"],
+        json!(["codex", "--cd", "/repo/main", "resume", root_id])
+    );
+
+    let (stdout, _) = assert_success(run_fr(temp.path(), &["--json", "--all", "-a", "codex"]));
+    let refreshed: Value = serde_json::from_str(&stdout).unwrap();
+    assert_eq!(refreshed["sessions"].as_array().unwrap().len(), 1);
+    assert_eq!(refreshed["sessions"][0]["id"], root_id);
+}
