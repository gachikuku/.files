+#[test]
+fn cached_codex_subagent_routes_to_main_then_refresh_hides_it() {
+    let temp = TempDir::new().unwrap();
+    let root_id = "019abcde-1234-5678-9abc-def012345678";
+    let child_id = "019abcde-9876-5432-9abc-def087654321";
+    write_codex_session(temp.path(), root_id, "/repo/main", "Main request");
+    let child_path = write_codex_session(temp.path(), child_id, "/repo/worktree", "Child request");
+    assert_success(run_fr(temp.path(), &["--json", "--all"]));
+
+    // Simulate a cached child from a previous picker version: the persisted
+    // document has no ancestry, but Codex's durable header records its parent.
+    write_jsonl(
+        &child_path,
+        &[
+            json!({"type": "session_meta", "payload": {"id": child_id, "cwd": "/repo/worktree", "source": {"subagent": {"thread_spawn": {"parent_thread_id": root_id}}}}}),
+            json!({"type": "event_msg", "payload": {"type": "user_message", "message": "Child request"}}),
+        ],
+    );
+    let (stdout, _) = assert_success(run_fr(
+        temp.path(),
+        &["--json", "--no-refresh", "--limit", "1", child_id],
+    ));
+    let cached: Value = serde_json::from_str(&stdout).unwrap();
+    assert_eq!(cached["sessions"][0]["id"], child_id);
+    assert_eq!(
+        cached["sessions"][0]["resume_command"],
+        json!(["codex", "--cd", "/repo/main", "resume", root_id])
+    );
+
+    let (stdout, _) = assert_success(run_fr(temp.path(), &["--json", "--all", "-a", "codex"]));
+    let refreshed: Value = serde_json::from_str(&stdout).unwrap();
+    assert_eq!(refreshed["sessions"].as_array().unwrap().len(), 1);
+    assert_eq!(refreshed["sessions"][0]["id"], root_id);
+}
