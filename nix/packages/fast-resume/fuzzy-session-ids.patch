+                Err(_) => return Self::default(),
+            },
+            Ok(None) => query_grammar::parse_query_lenient(&text).0,
+            Err(_) => return Self::default(),
+        };
+        let mut matcher = Self::default();
+        matcher.collect(ast);
+        matcher
+    }
+
+    fn collect(&mut self, ast: UserInputAst) {
+        match ast {
+            UserInputAst::Clause(clauses) => {
+                for (occur, ast) in clauses {
+                    if occur != Some(Occur::MustNot) {
+                        self.collect(ast);
+                    }
+                }
+            }
+            UserInputAst::Boost(ast, _) => self.collect(*ast),
+            UserInputAst::Leaf(leaf) => match *leaf {
+                UserInputLeaf::Literal(literal)
+                    if literal
+                        .field_name
+                        .as_deref()
+                        .is_none_or(|field| field == "content") =>
+                {
+                    match literal.delimiter {
+                        Delimiter::DoubleQuotes => self.add_regex(&literal.phrase),
+                        Delimiter::SingleQuotes => {
+                            let mut analyzer = chat_analyzer();
+                            let mut stream = analyzer.token_stream(&literal.phrase);
+                            let mut phrase = Vec::new();
+                            while stream.advance() {
+                                phrase.push(stream.token().clone());
+                            }
+                            if !phrase.is_empty() {
+                                self.phrases.push(phrase);
+                            }
+                        }
+                        Delimiter::None => {
+                            if !literal.phrase.is_empty()
+                                && let Ok(regex) =
+                                    RegexBuilder::new(&regex::escape(&literal.phrase))
+                                        .case_insensitive(true)
+                                        .build()
+                            {
+                                self.literals.push(regex);
+                            }
+                        }
+                    }
+                }
+                UserInputLeaf::Regex { field, pattern }
+                    if field.as_deref().is_none_or(|field| field == "content") =>
+                {
+                    self.add_regex(&pattern)
+                }
+                _ => {}
+            },
+        }
+    }
+
+    fn add_regex(&mut self, pattern: &str) {
+        if !pattern.is_empty()
+            && pattern.len() <= 1024
+            && let Ok(regex) = Regex::new(&format!(r"\A(?i:{pattern})\z"))
+        {
+            self.tokens.push(regex);
+        }
+    }
+
+    pub(super) fn first_match(&self, text: &str) -> Option<usize> {
+        self.literals
+            .iter()
+            .filter_map(|regex| regex.find(text).map(|hit| hit.start()))
+            .chain(
+                self.token_ranges(text, true)
+                    .into_iter()
+                    .map(|range| range.start),
+            )
+            .min()
+    }
+
+    pub(super) fn ranges(&self, text: &str) -> Vec<Range<usize>> {
+        let mut ranges = self.token_ranges(text, false);
+        for regex in &self.literals {
+            ranges.extend(regex.find_iter(text).map(|hit| hit.range()));
+        }
+        ranges.sort_by_key(|range| range.start);
+        let mut merged: Vec<Range<usize>> = Vec::new();
+        for range in ranges {
+            if let Some(last) = merged.last_mut()
+                && range.start <= last.end
+            {
+                last.end = last.end.max(range.end);
+            } else {
+                merged.push(range);
+            }
+        }
+        merged
+    }
+
+    fn token_ranges(&self, text: &str, first_only: bool) -> Vec<Range<usize>> {
+        if self.tokens.is_empty() && self.phrases.is_empty() {
+            return Vec::new();
+        }
+        let mut analyzer = chat_analyzer();
+        let mut stream = analyzer.token_stream(text);
+        let mut ranges = Vec::new();
+        let max_phrase = self.phrases.iter().map(Vec::len).max().unwrap_or(0);
+        let mut recent: VecDeque<Token> = VecDeque::new();
+        while stream.advance() {
+            let token = stream.token();
+            if self.tokens.iter().any(|regex| regex.is_match(&token.text)) {
+                ranges.push(token.offset_from..token.offset_to);
+            }
+            if max_phrase > 0 {
+                recent.push_back(token.clone());
+                if recent.len() > max_phrase {
+                    recent.pop_front();
+                }
+                for phrase in &self.phrases {
+                    if recent.len() < phrase.len() {
+                        continue;
+                    }
+                    let start = recent.len() - phrase.len();
+                    let first = &recent[start];
+                    if recent
+                        .iter()
+                        .skip(start)
+                        .zip(phrase)
+                        .all(|(actual, expected)| {
+                            actual.text == expected.text
+                                && actual.position - first.position
+                                    == expected.position - phrase[0].position
+                        })
+                    {
+                        ranges.push(first.offset_from..token.offset_to);
+                    }
+                }
+            }
+            if first_only && !ranges.is_empty() {
+                break;
+            }
+        }
+        ranges
+    }
+}
