+#[test]
+fn codex_search_indexes_chat_without_injected_context_or_reasoning() {
+    let temp = TempDir::new().unwrap();
+    let path = write_codex_session(temp.path(), "clean-chat", "/repo/chat", "placeholder");
+    let prompt = "Please update AGENTS.md with chatvisiblemarker.";
+    write_jsonl(
+        &path,
+        &[
+            json!({"type": "session_meta", "payload": {"id": "clean-chat", "cwd": "/repo/chat"}}),
+            json!({"type": "response_item", "payload": {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "# AGENTS.md instructions for /repo/chat\n<INSTRUCTIONS>\ninjectedonlymarker\n</INSTRUCTIONS>"}]}}),
+            json!({"type": "response_item", "payload": {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "<environment_context>environmentonlymarker</environment_context>"}]}}),
+            json!({"type": "event_msg", "payload": {"type": "user_message", "message": prompt}}),
+            json!({"type": "response_item", "payload": {"type": "message", "role": "user", "content": [{"type": "input_text", "text": prompt}]}}),
+            json!({"type": "event_msg", "payload": {"type": "agent_reasoning", "text": "reasoningonlymarker"}}),
+            json!({"type": "response_item", "payload": {"type": "message", "role": "assistant", "channel": "analysis", "content": [{"type": "output_text", "text": "analysisonlymarker"}]}}),
+            json!({"type": "response_item", "payload": {"type": "function_call_output", "output": "toolonlymarker"}}),
+            json!({"type": "response_item", "payload": {"type": "message", "role": "assistant", "channel": "final", "content": [{"type": "output_text", "text": "Updated with replyvisiblemarker."}]}}),
+            json!({"type": "event_msg", "payload": {"type": "agent_message", "message": "Updated with replyvisiblemarker."}}),
+            json!({"type": "event_msg", "payload": {"type": "item_completed", "item": {"type": "UserMessage", "id": "user-two", "content": [{"type": "text", "text": "modernusermarker"}]}}}),
+            json!({"type": "event_msg", "payload": {"type": "item_completed", "item": {"type": "AgentMessage", "id": "reply-two", "phase": "final_answer", "content": [{"type": "Text", "text": "modernreplymarker"}]}}}),
+        ],
+    );
+    assert_success(run_fr(temp.path(), &["--rebuild"]));
+    for query in [
+        "chatvisiblemarker",
+        "replyvisiblemarker",
+        "AGENTS.md",
+        "modernusermarker",
+        "modernreplymarker",
+    ] {
+        let (stdout, _) = assert_success(run_fr(temp.path(), &["--json", "--no-refresh", query]));
+        let value: Value = serde_json::from_str(&stdout).unwrap();
+        assert_eq!(value["sessions"][0]["id"], "clean-chat", "{query}");
+        assert_eq!(value["sessions"][0]["title"], prompt);
+        assert_eq!(value["sessions"][0]["message_count"], 2);
+    }
+    for query in [
+        "injectedonlymarker",
+        "environmentonlymarker",
+        "reasoningonlymarker",
+        "analysisonlymarker",
+        "toolonlymarker",
+    ] {
+        let (stdout, _) = assert_success(run_fr(temp.path(), &["--json", "--no-refresh", query]));
+        let value: Value = serde_json::from_str(&stdout).unwrap();
+        assert_eq!(value["meta"]["total"], 0, "{query}");
+    }
+}
