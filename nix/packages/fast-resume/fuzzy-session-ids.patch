diff --git a/src/index/tokenizer.rs b/src/index/tokenizer.rs
new file mode 100644
index 0000000..f8c5e33
--- /dev/null
+++ b/src/index/tokenizer.rs
@@ -0,0 +1,39 @@
+use std::sync::LazyLock;
+
+use regex::Regex;
+use tantivy::Index;
+use tantivy::tokenizer::{LowerCaser, RegexTokenizer, RemoveLongFilter, TextAnalyzer};
+
+pub(super) const NAME: &str = "chat";
+
+// Preserve SimpleTokenizer's alphanumeric words, and keep emoji sequences
+// together so a search for one compound emoji does not match its components.
+static ANALYZER: LazyLock<TextAnalyzer> = LazyLock::new(|| {
+    let tokenizer = RegexTokenizer::new(concat!(
+        r"[#*0-9]\u{FE0F}?\u{20E3}|",
+        r"\p{Regional_Indicator}{2}|",
+        r"\u{1F3F4}[\u{E0020}-\u{E007E}]+\u{E007F}|",
+        r"\p{S}[\u{FE0E}\u{FE0F}\p{Emoji_Modifier}]*",
+        r"(?:\u{200D}\p{S}[\u{FE0E}\u{FE0F}\p{Emoji_Modifier}]*)*|",
+        r"[\p{Alphabetic}\p{N}]+",
+    ))
+    .expect("valid chat token pattern");
+    TextAnalyzer::builder(tokenizer)
+        .filter(RemoveLongFilter::limit(40))
+        .filter(LowerCaser)
+        .build()
+});
+
+pub(super) fn register(index: &Index) {
+    index.tokenizers().register(NAME, ANALYZER.clone());
+}
+
+pub(crate) fn chat_analyzer() -> TextAnalyzer {
+    ANALYZER.clone()
+}
+
+pub(super) fn contains_symbols(text: &str) -> bool {
+    static SYMBOLS: LazyLock<Regex> =
+        LazyLock::new(|| Regex::new(r"[\p{S}\u{20E3}]").expect("valid symbol pattern"));
+    SYMBOLS.is_match(text)
+}
