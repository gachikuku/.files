+        ("prefix", "mizuki"),
+        ("inside", "kamizu"),
+        ("typo", "mizo"),
+        ("water", "water"),
+    ] {
+        write_codex_session(temp.path(), id, "/repo/api", prompt);
+    }
+    assert_success(run_fr(temp.path(), &["--json"]));
+    for (query, expected) in [
+        (r#""mizu""#, vec!["exact"]),
+        (r#""mizu.*""#, vec!["exact", "prefix"]),
+        (r#"".*mizu.*""#, vec!["exact", "inside", "prefix"]),
+        (
+            r#""mizu|water" agent:codex dir:api"#,
+            vec!["exact", "water"],
+        ),
+        ("content:/mizu|water/", vec!["exact", "water"]),
+    ] {
+        let (stdout, _) = assert_success(run_fr(temp.path(), &["--json", "--no-refresh", query]));
+        let value: Value = serde_json::from_str(&stdout).unwrap();
+        let mut ids: Vec<_> = value["sessions"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|session| session["id"].as_str().unwrap())
+            .collect();
+        ids.sort();
+        assert_eq!(ids, expected, "query: {query}");
+    }
+    for query in [r#""[""#, r#""mizu"#, r#""""#] {
+        let (stdout, stderr) =
+            assert_failure(run_fr(temp.path(), &["--json", "--no-refresh", query]));
+        assert!(stdout.is_empty());
+        assert!(stderr.to_lowercase().contains("regex"), "{stderr}");
+    }
