+    let (stdout, _) = assert_success(run_fr(temp.path(), &["--json", "--no-refresh", "--all"]));
+    let output: Value = serde_json::from_str(&stdout).unwrap();
+    assert_eq!(output["schema_version"], 1);
+    let sessions = output["sessions"].as_array().unwrap();
+    assert_eq!(sessions.len(), 3);
+    assert!(sessions.iter().all(|session| session["id"] != "child"));
+    for (id, parent) in [
+        ("original", None),
+        ("fork-one", Some("original")),
+        ("fork-two", Some("fork-one")),
+    ] {
+        let session = sessions.iter().find(|session| session["id"] == id).unwrap();
+        assert_eq!(
+            session.get("forked_from_id").and_then(Value::as_str),
+            parent
+        );
+        assert_eq!(session["resume_command"], json!(["codex", "resume", id]));
+        for internal in ["content", "mtime", "yolo"] {
+            assert!(session.get(internal).is_none());
+        }
+    }
