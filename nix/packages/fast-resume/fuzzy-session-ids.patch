+#[derive(Clone, Copy, PartialEq, Eq)]
+enum ChatSource {
+    Response,
+    Event,
+}
+
+struct ChatMessage {
+    role: &'static str,
+    text: String,
+    source: ChatSource,
+    record: usize,
+}
+
+fn append_chat_message(
+    messages: &mut Vec<ChatMessage>,
+    role: &'static str,
+    text: String,
+    source: ChatSource,
+    record: usize,
+) {
+    let text = text.trim();
+    if text.is_empty() {
+        return;
+    }
+    // Codex can record one visible message in both streams. Pair only local,
+    // adjacent opposite-source records; intervening turn boundaries or other
+    // records prevent identical real messages from being mistaken for mirrors.
+    if let Some(previous) = messages.last()
+        && previous.role == role
+        && previous.text == text
+        && previous.source != source
+        && previous.record + 1 == record
+    {
+        return;
+    }
+    messages.push(ChatMessage {
+        role,
+        text: text.to_string(),
+        source,
+        record,
+    });
+}
+
+fn visible_assistant_message(payload: &Value) -> bool {
+    ["channel", "phase"].iter().all(|key| {
+        matches!(
+            payload.get(*key).and_then(Value::as_str),
+            None | Some("commentary" | "final" | "final_answer")
+        )
+    }) && matches!(
+        payload.get("recipient").and_then(Value::as_str),
+        None | Some("all")
+    )
+}
+
+fn chat_text(payload: &Value, user: bool) -> String {
+    let text = |part: &Value, kind: Option<&str>| {
+        if user
+            && kind.is_some_and(|kind| {
+                kind.starts_with("agents_md.") || kind.starts_with("environments.")
+            })
+        {
+            return None;
+        }
+        if part
+            .get("type")
+            .and_then(Value::as_str)
+            .is_some_and(|kind| !matches!(kind, "text" | "Text" | "input_text" | "output_text"))
+        {
+            return None;
+        }
+        let text = part
+            .as_str()
+            .or_else(|| part.get("text").and_then(Value::as_str))?;
+        Some(
+            if !user {
+                text
+            } else if kind == Some("user.text")
+                || payload.get("type").and_then(Value::as_str) == Some("UserMessage")
+            {
+                // Explicit human text may deliberately quote an instruction
+                // envelope. Use prefix heuristics only for legacy/unknown kinds.
+                text
+            } else {
+                clean_user_chat(text)
+            }
+            .to_string(),
+        )
+    };
+    let content = payload.get("content").unwrap_or(&Value::Null);
+    match content {
+        Value::Array(parts) => {
+            let kinds = payload
+                .pointer("/internal_chat_message_metadata_passthrough/content_item_kinds")
+                .and_then(Value::as_array)
+                .filter(|kinds| kinds.len() == parts.len());
+            parts
+                .iter()
+                .enumerate()
+                .filter_map(|(index, part)| {
+                    text(part, kinds.and_then(|kinds| kinds[index].as_str()))
+                })
+                .collect::<Vec<_>>()
+                .join("\n")
+        }
+        _ => text(content, None).unwrap_or_default(),
+    }
+}
+
+fn clean_user_chat(mut text: &str) -> &str {
+    text = text.trim();
+    loop {
+        if text.starts_with("# AGENTS.md instructions") {
+            // This header is an injected document only when accompanied by
+            // its envelope. Ordinary requests mentioning AGENTS.md stay intact.
+            if text.contains("<INSTRUCTIONS>") {
+                let Some((_, remaining)) = text.split_once("</INSTRUCTIONS>") else {
+                    return "";
+                };
+                text = remaining.trim_start();
+                continue;
+            }
+        }
+        let envelope = [
+            ("<environment_context", "</environment_context>"),
+            ("<system_reminder", "</system_reminder>"),
+            ("<subagent_notification", "</subagent_notification>"),
+            ("<agent_notification", "</agent_notification>"),
+            ("<developer_instructions", "</developer_instructions>"),
+            ("<user_instructions", "</user_instructions>"),
+            ("<INSTRUCTIONS", "</INSTRUCTIONS>"),
+        ]
+        .into_iter()
+        .find(|(open, _)| {
+            text.strip_prefix(open)
+                .is_some_and(|rest| rest.starts_with('>') || rest.starts_with(' '))
+        });
+        if let Some((_, close)) = envelope {
+            let Some((_, remaining)) = text.split_once(close) else {
+                return "";
+            };
+            text = remaining.trim_start();
+            continue;
+        }
+        break;
+    }
+    ide_request(text)
+}
+
+fn ide_request(text: &str) -> &str {
+    let text = text.trim();
+    if (text.starts_with("# Context from my IDE setup:")
+        || text.starts_with("# Files mentioned by the user:")
+        || text.starts_with("## My request for Codex:"))
+        && let Some((_, request)) = text.split_once("## My request for Codex:")
+    {
+        return request.trim();
+    }
+    text.trim()
+}
+
+fn parent_thread_id(metadata: &Value) -> Option<&str> {
+    metadata
+        .get("parent_thread_id")
+        .and_then(Value::as_str)
+        .or_else(|| {
+            metadata
+                .pointer("/source/subagent/thread_spawn/parent_thread_id")
+                .and_then(Value::as_str)
+        })
+        .filter(|id| !id.is_empty())
+}
+
+fn is_subagent(metadata: &Value) -> bool {
+    parent_thread_id(metadata).is_some()
+        || metadata.pointer("/source/subagent").is_some()
+        || metadata.get("source").and_then(Value::as_str) == Some("subagent")
+        || metadata
+            .get("agent_path")
+            .and_then(Value::as_str)
+            .is_some_and(|path| !path.is_empty() && path != "/root")
+}
+
+fn rollout_metadata(path: &Path) -> Option<Value> {
+    let file = fs::File::open(path).ok()?;
+    for line in BufReader::new(file.take(1024 * 1024))
+        .lines()
+        .take(16)
+        .map_while(Result::ok)
+    {
+        let Ok(row) = serde_json::from_str::<Value>(&line) else {
+            continue;
+        };
+        if row.get("type").and_then(Value::as_str) == Some("session_meta") {
+            return row.get("payload").cloned();
+        }
+    }
+    None
+}
