+    /// Closing a streamed episode must save its position and reopening must start there.
+    #[test]
+    #[ignore = "requires ffmpeg and mpv in PATH"]
+    fn streamed_episode_saves_and_resumes() {
+        let directory = tempfile::tempdir().unwrap();
+        let video = directory.path().join("episode.mkv");
+        assert!(
+            Command::new("ffmpeg")
+                .args([
+                    "-nostdin",
+                    "-hide_banner",
+                    "-loglevel",
+                    "error",
+                    "-y",
+                    "-f",
+                    "lavfi",
+                    "-i",
+                    "testsrc2=size=160x90:rate=10",
+                    "-f",
+                    "lavfi",
+                    "-i",
+                    "sine=frequency=440:sample_rate=48000",
+                    "-t",
+                    "120",
+                    "-c:v",
+                    "ffv1",
+                    "-c:a",
+                    "pcm_s16le"
+                ])
+                .arg(&video)
+                .status()
+                .unwrap()
+                .success()
+        );
+        let saved = Mutex::new(None);
+        let report = |seconds| *saved.lock().unwrap() = Some(seconds);
+        let script = directory.path().join("stop.lua");
+        std::fs::write(
+            &script,
+            r#"
+local stopping = false
+mp.observe_property("time-pos", "number", function(_, position)
+    if position and position >= 45 and not stopping then
+        stopping = true
+        mp.set_property_native("pause", true)
+        mp.add_timeout(2, function() mp.commandv("quit", "0") end)
+    end
+end)
+mp.add_timeout(8, function() mp.commandv("quit", "1") end)
+"#,
+        )
+        .unwrap();
+        let mut args = vec![
+            "--no-config".into(),
+            "--vo=null".into(),
+            "--ao=null".into(),
+            "--speed=50".into(),
+            "--demuxer-max-bytes=256KiB".into(),
+            "--demuxer-max-back-bytes=0".into(),
+            format!("--script={}", script.display()),
+        ];
+        play(
+            &LivePipes::new(0).unwrap(),
+            &track(video.clone()),
+            &[track(video.clone())],
+            &[],
+            &EpisodeInfo::default(),
+            &Playback {
+                mpv_args: &args,
+                start_at: None,
+                playhead: Some(&report),
+            },
+        )
+        .expect("first playback must close normally");
+        let saved = saved
+            .into_inner()
+            .unwrap()
+            .expect("closing mpv must report a position");
+        assert!(
+            saved >= 45,
+            "saved {saved}, expected the point where playback stopped"
+        );
+        let start_at = resume_at(saved, 120_000, false);
+        assert_eq!(start_at, Some(saved));
+        let resumed = directory.path().join("resumed.txt");
+        std::fs::write(
+            &script,
+            format!(
+                r#"
+local recorded = false
+local stopping = false
+mp.observe_property("time-pos", "number", function(_, position)
+    if position and position > 0 and not recorded then
+        recorded = true
+        local f = assert(io.open({path:?}, "w"))
+        f:write(tostring(position))
+        f:close()
+    end
+    if position and position >= {stop_at} and not stopping then
+        stopping = true
+        mp.set_property_native("pause", true)
+        mp.add_timeout(2, function() mp.commandv("quit", "0") end)
+    end
+end)
+mp.add_timeout(8, function() mp.commandv("quit", "1") end)
+"#,
+                path = resumed.to_str().unwrap(),
+                stop_at = saved + 5
+            ),
+        )
+        .unwrap();
+        args.retain(|arg| !arg.starts_with("--speed="));
+        args.push("--speed=10".into());
+        let saved_again = Mutex::new(None);
+        let report_again = |seconds| *saved_again.lock().unwrap() = Some(seconds);
+        play(
+            &LivePipes::new(0).unwrap(),
+            &track(video.clone()),
+            &[track(video)],
+            &[],
+            &EpisodeInfo::default(),
+            &Playback {
+                mpv_args: &args,
+                start_at,
+                playhead: Some(&report_again),
+            },
+        )
+        .expect("resumed playback must open normally");
+        let actual: f64 = std::fs::read_to_string(resumed).unwrap().parse().unwrap();
+        assert!(
+            (f64::from(saved) - 1.0..=f64::from(saved) + 2.0).contains(&actual),
+            "reopened at {actual}s instead of the saved {saved}s"
+        );
+        let saved_again = saved_again
+            .into_inner()
+            .unwrap()
+            .expect("resumed playback reports progress");
+        assert!(
+            (saved + 5..=saved + 8).contains(&saved_again),
+            "resumed position {saved_again} must stay on the original episode timeline"
+        );
+        eprintln!("saved {saved}s; reopened at {actual}s; saved again at {saved_again}s");
+    }
+
