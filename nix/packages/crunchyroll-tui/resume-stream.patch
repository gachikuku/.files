+        // Output-side seeking reads and discards the prefix even when the inputs
+        // are pipes. Keep episode timestamps so mpv reports the absolute position
+        // and audio/subtitles stay on the same timeline after resuming.
+        ffmpeg.args([
+            "-ss",
+            &seconds.to_string(),
+            "-output_ts_offset",
+            &seconds.to_string(),
+        ]);
